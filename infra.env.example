# Container-bootstrap credentials for docker-compose — NOT app runtime config.
# The app's runtime inventory is .env (generated from SRS TD-13); this file
# exists separately so .env.example stays in exact lockstep with the TD-13
# table (see docs/CHANGES.log M1.1 ambiguity note).
#
# Usage: cp infra.env.example infra.env  →  fill in. Never commit infra.env.
#
# MUST match the password embedded in DATABASE_URL in .env
# (postgres://app:<this password>@db:5432/bodour).
POSTGRES_PASSWORD=
