    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
