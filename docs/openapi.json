{
  "openapi": "3.1.0",
  "info": {
    "title": "بذور الأمل Platform API",
    "version": "0.1.0",
    "description": "Generated from the implementation. The SRS TD-3 route registry is the canonical contract (§3.1); this document must conform to it and is never hand-edited."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin API path (§3.1)"
    }
  ],
  "paths": {
    "/auth/google": {
      "get": {
        "summary": "Begin Google OAuth",
        "description": "Redirects to Google with state + PKCE (§4.1b steps 1–2, TD-12).",
        "responses": {
          "302": {
            "description": "Redirect to Google."
          }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "summary": "Google OAuth callback",
        "description": "§4.1b routing: existing identity → session by status; pre-provisioned email match → bind identity → session by status; unknown → onboarding. Failures are REDIRECTS to /login?error=<key>, never the TD-3.8 envelope (§4.1b step 7).",
        "responses": {
          "302": {
            "description": "Redirect by routing decision, or to /login?error=<key> on failure."
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate the refresh token",
        "description": "The ONLY cookie-authenticated route (TD-12). Requires X-Requested-With and an Origin matching PUBLIC_BASE_URL. Rotation, the 10s predecessor grace window, and reuse detection are per TD-4.13 and §18 T1–T12.",
        "responses": {
          "200": {
            "description": "New access token; a rotated refresh cookie unless the grace window applied."
          },
          "401": {
            "description": "Error envelope (TD-3.8). All refusal reasons are deliberately indistinguishable."
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Log out of the current session",
        "description": "Revokes the current session only; other devices are unaffected (TD-4.14).",
        "responses": {
          "204": {
            "description": "Session revoked. Idempotent."
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Current identity",
        "description": "Identity, roles, branch scopes, account_status and approved child links. The only endpoint (with logout) that a Pending session may call (TD-1).",
        "responses": {
          "200": {
            "description": "Current user."
          },
          "401": {
            "description": "Error envelope (TD-3.8)."
          }
        }
      }
    },
    "/admin/branches": {
      "get": {
        "summary": "List branches",
        "description": "Ordered by display_order ASC NULLS LAST then name (ar-x-icu collated, §2.2/TD-10). Admins see their scoped branches; Super Admins see all.",
        "responses": {
          "200": {
            "description": "Branch list."
          },
          "401": {
            "description": "Error envelope (TD-3.8)."
          },
          "403": {
            "description": "Error envelope (TD-3.8)."
          }
        }
      },
      "post": {
        "summary": "Create a branch",
        "description": "Admin or Super Admin (TD-2). display_order is Super Admin only (§2.2).",
        "responses": {
          "201": {
            "description": "Created."
          },
          "400": {
            "description": "Error envelope (TD-3.8)."
          },
          "403": {
            "description": "Error envelope (TD-3.8)."
          }
        }
      }
    },
    "/admin/branches/{id}": {
      "patch": {
        "summary": "Update a branch",
        "description": "Optimistic locking on `version` (TD-15): a stale version returns 409 VERSION_CONFLICT rather than overwriting silently.",
        "responses": {
          "200": {
            "description": "Updated."
          },
          "404": {
            "description": "Error envelope (TD-3.8)."
          },
          "409": {
            "description": "Error envelope (TD-3.8). VERSION_CONFLICT."
          }
        }
      },
      "delete": {
        "summary": "Soft-delete a branch",
        "description": "Prohibited while Rooms or Groups reference it (TD-5) — 409 STATE_CONFLICT. Writes a Trash snapshot and an audit row (TD-4.8).",
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "404": {
            "description": "Error envelope (TD-3.8)."
          },
          "409": {
            "description": "Error envelope (TD-3.8). STATE_CONFLICT when referenced."
          }
        }
      }
    },
    "/admin/branches/{id}/rooms": {
      "get": {
        "summary": "List a branch's rooms",
        "description": "Scoped to the branch (§5.6).",
        "responses": {
          "200": {
            "description": "Room list."
          },
          "404": {
            "description": "Error envelope (TD-3.8)."
          }
        }
      },
      "post": {
        "summary": "Create a room",
        "description": "Within the given branch (§5.6).",
        "responses": {
          "201": {
            "description": "Created."
          },
          "400": {
            "description": "Error envelope (TD-3.8)."
          },
          "404": {
            "description": "Error envelope (TD-3.8)."
          }
        }
      }
    },
    "/admin/rooms/{id}": {
      "patch": {
        "summary": "Update a room",
        "description": "Optimistic locking on `version` (TD-15).",
        "responses": {
          "200": {
            "description": "Updated."
          },
          "404": {
            "description": "Error envelope (TD-3.8)."
          },
          "409": {
            "description": "Error envelope (TD-3.8). VERSION_CONFLICT."
          }
        }
      },
      "delete": {
        "summary": "Soft-delete a room",
        "description": "Prohibited while Groups reference it (TD-5).",
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "404": {
            "description": "Error envelope (TD-3.8)."
          },
          "409": {
            "description": "Error envelope (TD-3.8). STATE_CONFLICT when referenced."
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Health check",
        "description": "Public. Checks database, storage and job-queue components (TD-14); §19.1 step 8 asserts a 200 here on deployment.",
        "responses": {
          "200": {
            "description": "All components healthy."
          },
          "503": {
            "description": "At least one component is down."
          }
        }
      }
    }
  }
}
