{
  // Same surface as the build, without emitting — used by `npm run typecheck`
  // and by CI (§19.2).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  // Re-include the test files the build artifact deliberately omits: they must
  // still be typechecked, they just must not be emitted into dist/.
  "exclude": []
}
