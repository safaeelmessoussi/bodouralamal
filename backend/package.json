{
  "name": "bodour-backend",
  "version": "0.1.0",
  "private": true,
  "description": "بذور الأمل platform — Express/Prisma API (SRS §3.1, §16.1)",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@prisma/client": "7.9.0",
    "express": "5.2.1",
    "pg-boss": "12.26.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "prisma": "7.9.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
