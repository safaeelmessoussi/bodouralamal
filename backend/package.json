{
  "name": "bodour-backend",
  "version": "0.1.0",
  "private": true,
  "description": "بذور الأمل platform — Express/Prisma API (SRS §3.1, §16.1)",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp prisma/seed/*.json dist/prisma/seed/",
    "start": "node dist/src/index.js",
    "lint": "eslint src prisma/seed",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed:production": "node dist/prisma/seed/production.js",
    "seed:fixtures": "node dist/prisma/seed/fixtures.js",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "pg-boss": "12.26.2",
    "prisma": "7.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
