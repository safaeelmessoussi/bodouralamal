// بذور الأمل — data model (SRS §7).
//
// BINDING (TD-6a, §20 rule 5): this file declares ONLY what Prisma can express
// — tables, columns, enums, FKs, and PLAIN unique indexes. The following are
// deliberately absent and live in hand-written SQL migrations instead, because
// Prisma either cannot express them or would silently drop them:
//   * the native `ar-x-icu` collation on structural `name` columns and on
//     sortable person-name columns
//   * every CHECK constraint (ayah bounds, 0–10,000 bp scores, display_order,
//     group time/capacity, academic-year label, Hijri offset, lowercase email)
//   * every PARTIAL unique index (`WHERE deleted_at IS NULL`, `is_current`)
//   * the cross-table ayah-bounds trigger
// Adding any of those here would fail to compile or, worse, drop the guarantee.
//
// Conventions (§16.2): UUID primary keys everywhere except the natural-key
// static lookup `QuranSurah`; snake_case columns and tables; camelCase fields.
//
// NOT PRESENT BY DESIGN (§10.1, §20 rule 16 — do not pre-create):
//   GradingTemplate / GradingTemplateItem (post-MVP weight-template engine)
//   Committee / TeacherCommittee / LevelCommittee
//   Notification / NotificationPreference
// There is no tenant dimension anywhere (Revision 11, §3.2) — never reintroduce
// tenant columns, claims, or scoping.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// TD-1 User lifecycle. The `Deleted` state of TD-1 is represented by
/// `deleted_at IS NOT NULL` rather than a fifth enum value, so a soft-deleted
/// user has exactly one source of truth instead of two that can disagree.
enum AccountStatus {
  pending
  active
  rejected
  suspended

  @@map("account_status")
}

/// Branch-level membership status, distinct from `account_status` (§7).
enum UserBranchStatus {
  active
  left
  paused

  @@map("user_branch_status")
}

enum AuthProvider {
  google

  @@map("auth_provider")
}

/// §7 Revision 27: the person-side half of `Level.gender_restriction`. Without
/// it the restriction is unenforceable — nothing could compare a person against
/// a `girls_only` Level. Nullable, so pre-Revision-27 accounts and staff need no
/// backfill; enrolment treats null as NOT eligible for a restricted Level.
enum Sex {
  female
  male

  @@map("sex")
}

enum GenderRestriction {
  any
  girls_only
  boys_only

  @@map("gender_restriction")
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday

  @@map("day_of_week")
}

/// TD-1 FamilyLink lifecycle; Approved/Rejected are terminal.
/// R62 — how a linked adult relates to the child. Three values, no free text
/// and no `other`: the platform asks only *may this person act for this child*,
/// and a grandparent who acts legally IS a legal guardian. Finer gradation would
/// record family structure that nothing consumes.
enum RelationshipType {
  mother
  father
  legal_guardian

  @@map("relationship_type")
}

/// R62 — the schooling stage a student is currently in.
///
/// **It INFORMS an administrator's placement decision and gates nothing.** No
/// logic may refuse a placement on this value, or on any age derived from it:
/// a student older than the usual high-school age still belongs in اليافعون if
/// she is still in high school. A rule automating that would refuse the very
/// case R62 was written around.
enum SchoolingStage {
  pre_primary
  primary
  middle
  high
  post_secondary
  not_in_school

  @@map("schooling_stage")
}

/// R62 — per-child decision on one application.
enum ChildApplicationStatus {
  pending
  approved
  rejected

  @@map("child_application_status")
}

/// R62 — what a REJECTED applicant is told. Bounded on purpose: a free-text
/// reason will eventually carry a safeguarding judgement ("could not verify
/// guardianship") that must not reach the applicant. The unbounded note lives
/// beside it and is never returned.
enum ChildApplicationRejectionReason {
  duplicate_application
  insufficient_information
  not_eligible
  other

  @@map("child_application_rejection_reason")
}

enum FamilyLinkStatus {
  pending
  approved
  rejected

  @@map("family_link_status")
}

enum ConsentType {
  media_release
  data_processing

  @@map("consent_type")
}

enum ConsentMethod {
  online_form
  staff_recorded

  @@map("consent_method")
}

/// BR-14 three-tier visibility. Never a boolean (§4.4, §4.9).
/// **R110 — which ENTITY a scheduling type is delivered by.**
///
/// The five catalogue rows an administrator sees map onto **three** entities,
/// and R56 settled which: *"the type selector's branches are exactly the ones
/// that mean something — the three that route to different entities."* This
/// enum is that routing, **stored on the row and never inferred from the Arabic
/// name** — §4.4b already forbids reading a rule off a name, and a catalogue
/// whose behaviour depended on its label could not be renamed.
///
/// | value | entity |
/// |---|---|
/// | `class` | `RecurringCourseSchedule` |
/// | `activity` | `Event` |
/// | `exam` | `Exam` |
///
/// The vocabulary is the client's existing one, deliberately: one word for one
/// concept across the seam, rather than a translation table nobody maintains.
enum SchedulingStructuralKind {
  class
  activity
  exam

  @@map("scheduling_structural_kind")
}

enum Visibility {
  public
  private
  hidden

  @@map("visibility")
}

/// **R99 — WHAT a content item IS, not what it is encoded as.**
///
/// «التسجيلات» used to be `mimeType.startsWith('audio/')`, which called every
/// attached audio file a recording and made a video one unrepresentable. This
/// is the smallest honest replacement: a **semantic** fact, in the
/// association's own vocabulary, that survives replacing the media platform
/// (R97.9). MIME still decides how an item plays and downloads — never whether
/// it is a recording.
enum ContentOrigin {
  /// Somebody uploaded it. Every row that existed before R99 is one of these,
  /// except those the R99.11 backfill reclassifies.
  uploaded
  /// A recording OF A CLASS — either the platform's own server-side capture of
  /// an online occurrence, or §4.9's phone-recorded-and-attached MVP flow.
  session_recording

  @@map("content_origin")
}

/// **R99 — where a recording is in its life.** Ordered as it actually
/// progresses; nothing skips backwards.
enum RecordingStatus {
  /// The provider has been asked and has not yet confirmed.
  starting
  /// Confirmed running. This is the state «جاري التسجيل» reports.
  recording
  /// A stop has been requested and the provider has not yet finished.
  stopping
  /// The provider is finalizing the file. **Not available**: the asset does
  /// not exist in Bodour storage yet (R99.14).
  processing
  /// The provider produced an object. **Still not `EducationalContent`** —
  /// ingestion is C2, and this is the state it consumes.
  completed
  /// The provider gave up, or ingestion could not proceed. Recoverable, and
  /// deliberately NOT a content item (R99.14).
  failed
  /// Ended before producing anything — a start that never became a recording.
  aborted

  @@map("recording_status")
}

/// §4.4 — ONE shared recurrence vocabulary, used by both `Event` and
/// `RecurringCourseSchedule` (Revision 43). Deliberately not modelled twice:
/// the alternating-week arithmetic is exactly the code nobody wants written in
/// two places. `none` is valid for an Event and PROHIBITED on a schedule (a
/// non-recurring occurrence is an Event) — enforced by CHECK in SQL.
enum RecurrenceType {
  none
  daily
  weekly
  multiple_weekdays
  biweekly_alternating
  monthly
  yearly

  @@map("recurrence_type")
}

/// §4.4c — which students a schedule's sessions are for. The mode lives on the
/// SCHEDULE and nowhere else (§20 rule 22): the same Level teaches one Subject
/// whole and another split, so it can be a property of neither Subject nor
/// Level. Each mode has exactly one matching target FK, enforced by CHECK.
enum TeachingMode {
  entire_level
  administrative_group
  teaching_group

  @@map("teaching_mode")
}

/// §4.4c — generalises the retired two-instructor-slot co-teaching rule rather
/// than duplicating it, and gives assistants a home without inventing a Role
/// (roles are seeded with no CRUD in the MVP, §7).
enum ScheduleStaffPosition {
  teacher
  assistant

  @@map("schedule_staff_position")
}

/// TD-1 Session lifecycle. Rescheduling and room changes are FIELD EDITS, not
/// transitions — they set the session's own date/time/room/teacher and mark it
/// `overridden`, which is what protects it from the next schedule edit (§4.4).
enum SessionStatus {
  scheduled
  cancelled
  held

  @@map("session_status")
}

/// **SRS Revision 97 — how a teaching occurrence is delivered.**
///
/// `in_person` is the association's historical and default mode: people come to
/// a Branch and sit in a Room. `online` is delivered over the network with no
/// physical venue at all.
///
/// **Provider-independent, deliberately.** This says *how the class reaches its
/// students*, never *which media platform carries it*. The provider decision is
/// recorded separately (`docs/development/online-class-provider.md`) and no
/// provider identifier belongs on a schedule or an occurrence — a domain that
/// names its vendor cannot survive replacing the vendor.
enum DeliveryMode {
  in_person
  online

  @@map("delivery_mode")
}

/// **R97 — what an online occurrence carries.** Meaningful only when
/// `delivery_mode = 'online'`, and refused otherwise by CHECK: an in-person
/// class has no media mode, and a nullable column that is sometimes set for one
/// would make *«is this class online?»* answerable two ways.
enum OnlineMediaMode {
  audio_video
  audio_only

  @@map("online_media_mode")
}

enum QuranLogCategory {
  new_memorization
  revision

  @@map("quran_log_category")
}

/// R58 — the discriminator, not a flag. Each mode carries exactly the columns
/// its own reality has: a physical sitting has a room and no questions, an
/// online one has questions and no room. CHECK constraints enforce that.
enum ExamMode {
  physical
  online

  @@map("exam_mode")
}

/// R58 — one supervisor and any number of assistants, mirroring
/// `ScheduleStaffPosition` (§4.4c): one table, one rule.
enum ExamStaffPosition {
  supervisor
  assistant

  @@map("exam_staff_position")
}

/// R71 — who answers for an event. **Not `ScheduleStaffPosition`**: reusing
/// `teacher | assistant` would call the مؤطرة running a celebration a teacher,
/// the conflation §20 rule 22 exists to prevent, and the same reason
/// `ExamStaffPosition` has its own values.
enum EventStaffPosition {
  responsible
  assistant

  @@map("event_staff_position")
}

enum ExamAccessPolicy {
  single_submission
  save_and_resume

  @@map("exam_access_policy")
}

/// TD-1 submission lifecycle.
enum SubmissionState {
  in_progress
  submitted
  auto_graded
  fully_graded

  @@map("submission_state")
}

/// TD-1 Grade lifecycle. Draft → Published only; the Published→Draft revert
/// belongs to the post-MVP recalculation engine (§10.1).
enum GradeStatus {
  draft
  published

  @@map("grade_status")
}

enum ConsumedTokenPurpose {
  onboarding

  @@map("consumed_token_purpose")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

/// Core identity. Minor students are User rows with NO UserIdentity records —
/// they are login-less and reached only through an approved FamilyLink
/// (§4.3, BR-5).
model User {
  /// R88 — the teaching profile: planning data, never authority.
  subjectCapabilities  TeacherSubjectCapability[]
  categoryCapabilities TeacherCategoryCapability[]
  availability         TeacherAvailability[]
  notifications        Notification[]              @relation("NotificationRecipient")
  examStaff            ExamStaff[]
  eventStaff           EventStaff[]                @relation("EventStaffUser")
  id                   String                      @id @default(uuid()) @db.Uuid

  /// **R96 — this person's stable, opaque QR identity.**
  ///
  /// One per person, for every person: beneficiary, child, teenager, guardian,
  /// مؤطِّرة, assistant, Admin, Super Admin, and anybody holding several of those
  /// at once. **Independent of all of them** — and of `isBeneficiary`,
  /// `Enrollment`, `FamilyLink`, academic year, Branch and Level. Roles change
  /// and placements change; neither reissues an identity.
  ///
  /// **It identifies; it never authenticates.** Not secret, not a bearer token,
  /// grants nothing: resolving it yields a person, and whatever follows runs the
  /// caller's own authorization exactly as a lookup by `id` would. R62.5's rule
  /// for `referenceCode`, restated because a second opaque identifier must not
  /// quietly acquire different powers.
  ///
  /// **Distinct from `id`** so a lost card can be reissued without rewriting
  /// every foreign key, and so the printed artifact and the row's identity can
  /// diverge (§20 rule 22). **Distinct from `referenceCode`** because that one
  /// is SPOKEN — a five-character human alphabet read down a telephone — and
  /// this one is SCANNED.
  ///
  /// **The default is the DATABASE's** (`gen_random_uuid()`), so every creation
  /// path has one whether or not it goes through Prisma, including paths nobody
  /// has written yet.
  qrRef String @unique @default(uuid()) @map("user_qr_ref") @db.Uuid

  accountStatus AccountStatus @default(pending) @map("account_status")

  // Person names. `nameArabic` is collated ar-x-icu by hand-written SQL
  // (TD-6a) so ordering is correct without per-query COLLATE (BR-19).
  /// Revision 40 — SERVER-COMPOSED from `firstNameArabic` + `lastNameArabic`.
  /// Never asked for and never composed by a client (§1.1): two clients would
  /// disagree about order and separator, and the wrong answer is a person's
  /// name rendered backwards. Remains what every consumer reads — TD-10 search,
  /// `ar-x-icu` ordering (BR-19), the display-identity fallback, the §14.2
  /// queue — and is a derived column of the same kind as the normalized shadow
  /// columns below. It is a defect for them to disagree.
  nameArabic String @map("name_arabic") @db.VarChar(120)

  /// الاسم الشخصي / الاسم العائلي (Revision 40) — the COLLECTED facts, written
  /// in the same transaction that creates the person. Nullable with no
  /// backfill: splitting an existing full name on whitespace would be a guess,
  /// and Moroccan names routinely carry compound personal names and multi-word
  /// family names. Null means "recorded before the parts were collected".
  firstNameArabic String? @map("first_name_arabic") @db.VarChar(60)
  lastNameArabic  String? @map("last_name_arabic") @db.VarChar(60)

  /// Revision 41 — server-composed from the French parts, exactly as
  /// `nameArabic` is from the Arabic ones. Retained for the same reason:
  /// consumers want the whole name, and a client must not decide its order.
  nameFrench String? @map("name_french") @db.VarChar(120)

  /// Revision 41 — the French name split like the Arabic one. ENTIRELY
  /// OPTIONAL: both parts or neither. Supplying exactly one is a validation
  /// failure, because half a name is not a name.
  firstNameFrench String? @map("first_name_french") @db.VarChar(60)
  lastNameFrench  String? @map("last_name_french") @db.VarChar(60)
  nickname        String? @db.VarChar(60)

  /// Revision 36.1 — the name shown on every PUBLIC surface when set;
  /// otherwise `nameArabic` is used. The backend resolves it and clients
  /// receive only the result: a client-side fallback would be a second source
  /// of truth for which name a person agreed to publish, and the wrong branch
  /// leaks a legal name. Distinct from `nickname`, which is an internal search
  /// convenience (TD-10).
  publicDisplayName String? @map("public_display_name") @db.VarChar(120)
  phone             String? @db.VarChar(20)
  /// Captured at registration (§4.1b step 5, Revision 27) — never patched on
  /// afterwards, because the registration exists before the User does.
  /// R80 — recorded at every creation, completed explicitly where missing, and
  /// required by the schema since `20260818220000_r80_sex_not_null`. A NULL has
  /// always meant *not eligible* for a restricted Level rather than
  /// *unknown-but-fine* (R27), which is why it could not stay optional.
  sex               Sex     @map("sex")

  /// **Is this person one of the institute's مستفيدات?** (Revision 79)
  ///
  /// The single authoritative answer, and **independent of every role**: a
  /// minor beneficiary holds no role row at all (§4.3), one account may hold
  /// both `teacher` and `student`, and a guardian who does not herself study is
  /// not a beneficiary. Nothing may be inferred in either direction.
  ///
  /// Set at **approval** — in the same transaction that clears `requestedRole`
  /// and `intendedCategoryId`, which is why those cannot carry it — and durable
  /// afterwards: ending an enrolment does not clear it, and holding none does
  /// not either.
  ///
  /// `Enrollment` is **evidence** for backfilling history and **never** the
  /// runtime definition (R79.6): enrolment cannot be the precondition for being
  /// enrollable.
  isBeneficiary Boolean @default(false) @map("is_beneficiary")
  notes         String? @db.VarChar(2000)

  /// Revision 39 — THE BRANCH THE APPLICANT ASKED FOR at registration.
  ///
  /// Deliberately NOT the answer to "which branch is this person in": that
  /// answer is their Group, through `StudentGroup → Group.branchId`, because an
  /// administrator may place an approved applicant at a different branch when
  /// the requested one is full or unsuitable. Naming this `branchId` would have
  /// made two different facts share one name and created a second source of
  /// truth for placement (§16.4).
  ///
  /// Nullable with NO backfill possible — accounts predating R39 have no such
  /// value and nobody knows what those applicants would have chosen, so null
  /// means *not stated*, never *no branch*. Required in the public
  /// self-service payload (§4.1b step 5); optional for staff-assisted
  /// registration (§4.1).
  ///
  /// `Restrict`, like every other reference to a Branch (TD-5): a branch with
  /// registrations pointing at it cannot be deleted out from under them.
  /// R62 — a short, stable, NON-PERSONAL student identifier.
  ///
  /// Random rather than sequential: a sequence leaks enrolment order and
  /// headcount and invites enumeration. The alphabet excludes `0/O` and `1/I/l`
  /// because it is read aloud and hand-copied.
  ///
  /// **It identifies; it never authorises.** A lookup by code runs exactly the
  /// same authorization as a lookup by id — otherwise the code becomes a bearer
  /// token by accident, and knowing a child's code would grant something.
  ///
  /// Students only; nullable because staff have none and rows predate it.
  referenceCode String? @unique @map("reference_code") @db.VarChar(16)

  /// R62 — informs placement, gates nothing. See `SchoolingStage`.
  schoolingStage SchoolingStage? @map("schooling_stage")

  intendedBranchId String? @map("intended_branch_id") @db.Uuid
  intendedBranch   Branch? @relation("UserIntendedBranch", fields: [intendedBranchId], references: [id], onDelete: Restrict)

  /// The educational stage the applicant asked for (Revision 49, proposed) —
  /// a REQUEST, exactly as `intended_branch_id` is. §4.1 step 1 preselects "the
  /// first Level of the applicant's Category" and nothing recorded one, so the
  /// clause was unimplementable. It narrows and preselects what the approver is
  /// offered; the approver may choose any Level, and the `Enrollment` is what
  /// admits the person. `Restrict`: a Category with pending requests must not
  /// vanish underneath them.
  intendedCategoryId String?   @map("intended_category_id") @db.Uuid
  intendedCategory   Category? @relation("UserIntendedCategory", fields: [intendedCategoryId], references: [id], onDelete: Restrict)

  /// The email authorized to claim this account BEFORE any external identity
  /// exists (§7, Revision 15). Staff set it when pre-provisioning; it is the
  /// only way an unbound account can be found by email, because `UserIdentity`
  /// rows exist solely for COMPLETED bindings — placeholder identity rows are
  /// prohibited. Null for self-registered accounts, which get their identity in
  /// the same transaction that creates them (§4.1b step 5).
  ///
  /// Retained, never cleared, after binding: clearing would destroy provenance
  /// and release the address for a second account to claim. Lowercase is
  /// enforced by a DB CHECK, and uniqueness among non-null values by a partial
  /// unique index — both hand-written (TD-6, TD-6a), since Prisma can express
  /// neither.
  preProvisionedEmail String? @map("pre_provisioned_email")

  /// What a self-service applicant ASKED TO BE (Revision 49, proposed) — a hint
  /// to the §5.6 approver and **never** an authority. Authority lives in
  /// `user_branch_role`, written at approval by a Super Admin; a self-declared
  /// value that granted access would be privilege escalation by form
  /// submission. Constrained in SQL to `teacher`: administrator accounts arrive
  /// through staff pre-provisioning (§4.1b step 4b), an authenticated path with
  /// a named actor. Retained after approval as provenance, like
  /// `pre_provisioned_email`.
  requestedRole String? @map("requested_role") @db.VarChar(40)

  // TD-10 normalized shadow columns, populated by the migration's
  // normalization function and indexed for substring search. Never normalized
  // per-row at query time.
  nameArabicNormalized String? @map("name_arabic_normalized")
  nameFrenchNormalized String? @map("name_french_normalized")
  nicknameNormalized   String? @map("nickname_normalized")
  phoneNormalized      String? @map("phone_normalized")

  /// TD-15 optimistic locking — staff-edited profile/role/scope changes.
  version Int @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  deletedById  String? @map("deleted_by") @db.Uuid
  deletedBy    User?   @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deletedUsers User[]  @relation("UserDeletedBy")

  identities    UserIdentity[]
  branchRoles   UserBranchRole[]
  socialProfile StudentSocialProfile?

  // Revision 43 (expand phase) — see the educational-model block below.
  levelEnrollments   Enrollment[]
  teachingGroupSeats StudentTeachingGroup[]
  staffedSchedules   CourseScheduleStaff[]
  staffedSessions    SessionStaff[]         @relation("SessionStaffUser")

  parentLinks FamilyLink[] @relation("FamilyLinkParent")
  childLinks  FamilyLink[] @relation("FamilyLinkChild")

  /// R62 — child applications, in each of the four roles a User can play on one.
  childApplicationsAsParent  ChildApplication[]      @relation("ChildApplicationParent")
  childApplicationsAsChild   ChildApplication[]      @relation("ChildApplicationChild")
  childApplicationsAsMatch   ChildApplication[]      @relation("ChildApplicationMatch")
  childApplicationsAsDecider ChildApplication[]      @relation("ChildApplicationDecider")
  quranLogs                  QuranProgressLog[]      @relation("QuranLogStudent")
  quranLogsAuthored          QuranProgressLog[]      @relation("QuranLogLoggedBy")
  surahProgress              StudentSurahProgress[]
  submissions                StudentExamSubmission[]
  grades                     Grade[]
  consentsAsSubject          ConsentRecord[]         @relation("ConsentStudent")
  consentsGranted            ConsentRecord[]         @relation("ConsentGrantedBy")
  consentsRevoked            ConsentRecord[]         @relation("ConsentRevokedBy")
  auditEntries               AuditLog[]
  trashEntries               Trash[]
  rateLimitCounters          RateLimitCounter[]
  refreshSessions            RefreshSession[]
  refreshTokens              RefreshToken[]
  /// R99 — recordings this person started or stopped. Two relations because a
  /// cover may stop what the main مؤطِّرة began, and both facts are audited.
  recordingsStarted          SessionRecording[]      @relation("RecordingStartedBy")
  recordingsStopped          SessionRecording[]      @relation("RecordingStoppedBy")

  @@index([accountStatus])
  @@index([deletedAt])
  // TD-10 shadow-column indexes. These MUST be declared here even though the
  // hand-written init migration already created them: Prisma diffs the live
  // database against this file, so an index it cannot see is drift it will
  // silently DROP in the next generated migration. (Caught exactly that way —
  // the TD-6b DROP lint blocked it.) Plain btree indexes are expressible in
  // Prisma, unlike the collations, CHECKs, partial indexes, and triggers that
  // §20 rule 5 keeps in SQL; the names match the migration's names so no
  // drop-and-recreate is generated.
  @@index([nameArabicNormalized])
  @@index([nameFrenchNormalized])
  @@index([nicknameNormalized])
  @@index([phoneNormalized])
  @@map("user")
}

/// Provider-abstracted auth linkage (§7). MVP: google only. Local credentials
/// join post-MVP as another provider WITHOUT restructuring User (§10.1).
/// No password column exists anywhere, ever (§20 rule 10).
model UserIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider          AuthProvider
  providerSubjectId String       @map("provider_subject_id")

  /// Always lowercased before every lookup and write (TD-12); the database
  /// independently enforces `CHECK (email = lower(email))` via TD-6a SQL.
  email String

  /// TD-5: user soft-delete deactivates identities rather than dropping them.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Plain unique — expressible in Prisma. The `(provider, email)` uniqueness
  // is scoped to ACTIVE identities and is therefore a partial index in SQL.
  @@unique([provider, providerSubjectId])
  @@index([email])
  @@map("user_identity")
}

/// Stable cross-table lock target for normalized email ownership decisions.
///
/// `User.preProvisionedEmail` and `UserIdentity.email` remain the authoritative
/// ownership facts. This row deliberately carries no owner id: it exists only
/// so registration, staff pre-provisioning, bootstrap and first binding can
/// serialize an email that had no row in either ownership channel when their
/// transactions began.
model NormalizedEmailLock {
  email     String   @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("normalized_email_lock")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  /// Seeded set (§15.1): super_admin, admin, teacher, student, parent.
  name String @unique

  branchRoles UserBranchRole[]

  @@map("role")
}

/// Role assignment scoped to a branch. Branch scoping is the sole
/// access-control axis in MVP (§4.2).
model UserBranchRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Null = unscoped (Super Admin, §2.1).
  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// The branch-level `user_status` of §7, kept separate from
  /// `User.account_status`.
  userStatus UserBranchStatus @default(active) @map("user_status")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branch_role")
}

// ---------------------------------------------------------------------------
// Structural entities — single Arabic `name`, collated ar-x-icu (§2.2, TD-6a)
// ---------------------------------------------------------------------------

model Branch {
  exams                Exam[]
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String    @db.VarChar(120)
  operationalStartDate DateTime? @map("operational_start_date") @db.Date
  /// Super-Admin-managed ordering (§2.2); CHECK (>= 0) in SQL.
  displayOrder         Int?      @map("display_order")

  /// Public contact fields (Revision 35) — the ONLY branch columns `GET
  /// /branches` may expose. Nullable at the database level so branches
  /// predating the revision need no invented address (the treatment
  /// `User.sex` received in Revision 27); *required* is enforced at the write
  /// boundary by TD-9, which is where a real value can be demanded.
  address        String? @db.VarChar(300)
  phone          String? @db.VarChar(20)
  /**
   * **NEW I — the SECOND number, as its own column.**
   * A branch commonly publishes two: a landline and a mobile, or an office line
   * and the coordinator's. Overloading `phone` with *«0537… / 0661…»* was the
   * alternative and is refused for the reason §7 refuses every packed field —
   * the value stops being a phone number, so nothing can dial it, validate it,
   * or render it as a link, and the split becomes a parsing problem the moment
   * anyone needs one of the two.
   * Nullable, and it stays nullable: a branch with one number is the ordinary
   * case, not a gap. Same TD-9 shape as `phone`.
   */
  phoneSecondary String? @map("phone_secondary") @db.VarChar(20)
  email          String? @db.VarChar(254)
  /// Free multiline Arabic text, displayed verbatim and NEVER parsed (§7).
  /// Ramadan and exceptional weeks change the hours; free text lets the person
  /// who knows edit them without a schema conversation.
  openingHoursAr String? @map("opening_hours_ar") @db.VarChar(500)
  /// Absolute https:// URL only (TD-9) — it becomes an outbound link on a
  /// public page, where a relative or javascript: value is an injection vector.
  googleMapsUrl  String? @map("google_maps_url") @db.VarChar(500)

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  rooms Room[]

  // Revision 43 (expand phase) — see the educational-model block below.
  administrativeGroups AdministrativeGroup[]
  courseSchedules      RecurringCourseSchedule[]
  branchRoles          UserBranchRole[]
  content              EducationalContent[]
  eventScopes          EventBranch[]
  /// Revision 39 — applicants who REQUESTED this branch at registration. Not
  /// the people placed here; that is `groups → StudentGroup`.
  intendedBy           User[]                    @relation("UserIntendedBranch")
  /// Revision 64 — the branch a child-registration request asked for.
  childApplications    ChildApplication[]
  /// Revision 66 — where each enrolled student actually is.
  enrollments          Enrollment[]
  /// R92 — occurrences whose audience explicitly includes this branch.
  sessionAudiences     SessionAudienceBranch[]

  @@index([displayOrder])
  @@map("branch")
}

model Room {
  exams    Exam[]
  id       String @id @default(uuid()) @db.Uuid
  name     String @db.VarChar(120)
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// **INFORMATIONAL ONLY — nothing compares a roster against it** (BR-23,
  /// §20 rule 22). Displayed to assist planning; no enrolment, placement or
  /// scheduling action is refused on it. The SQL CHECK constrains the value's
  /// shape (`> 0`) and nothing else.
  capacity Int?

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  // Revision 43 (expand phase) — see the educational-model block below.
  courseSchedules RecurringCourseSchedule[]
  sessions        Session[]

  @@index([branchId])
  @@map("room")
}

/// The three tracks (§4.4b): المرأة / اليافعات / الطفل.
model Category {
  teacherCapabilities TeacherCategoryCapability[]
  id                  String                      @id @default(uuid()) @db.Uuid
  name                String                      @db.VarChar(120)
  /// **NEW K — what this Category is, in the Owner's words** (2026-08-27).
  ///
  /// Nullable because a Category without one is ordinary, not incomplete. It is
  /// an attribute OF the Category rather than a policy attached to it, which is
  /// why it is a column here and not a `system_setting` row like §4.9's default
  /// visibility.
  description         String?                     @db.VarChar(500)
  displayOrder        Int?                        @map("display_order")

  // NOTE: the per-Category default content visibility (§4.9) is NOT a column
  // here — §7 defines Category as carrying only `name` and `display_order`,
  // and TD-13/§15.1 place that default in `SystemSetting`. Same reasoning for
  // the per-level passing grade on Level.

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  levels            Level[]
  /// R62 — the stage a parent applied to for a child. The administrator may
  /// change it: placement is an administrative decision, never a rule.
  childApplications ChildApplication[]
  eventScopes       EventCategory[]
  /// Revision 49 — applicants who asked for this stage. See `User`.
  intendedBy        User[]             @relation("UserIntendedCategory")

  @@index([displayOrder])
  @@map("category")
}

/// Level numbering is NOT uniform across categories — Women 0–7, Teens 1–6,
/// Children 0–6. No logic may assume every category has a level 0 (§4.4b).
model Level {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(120)
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Checked generically by progression logic — never hardcoded against a
  /// level name (§4.4b).
  genderRestriction GenderRestriction @default(any) @map("gender_restriction")

  /// Ordering is scoped within the parent Category (§2.2).
  /// **NEW L — what this Level is** (2026-08-27). See `Category.description`.
  description  String? @db.VarChar(500)
  displayOrder Int?    @map("display_order")

  // NOTE: the per-level passing grade is NOT a column here — §7 defines Level
  // as carrying only `name`, `gender_restriction`, and `display_order`, and
  // TD-13/§15.1 place the passing-grade default in `SystemSetting`.

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  subjects LevelSubject[]
  surahs   LevelSurah[]

  // Revision 43 (expand phase) — see the educational-model block below.
  administrativeGroups AdministrativeGroup[]
  teachingGroups       TeachingGroup[]
  enrollments          Enrollment[]
  courseSchedules      RecurringCourseSchedule[]
  teachingGroupSeats   StudentTeachingGroup[]
  exams                Exam[]
  content              EducationalContent[]
  eventScopes          EventLevel[]

  @@index([categoryId, displayOrder])
  @@map("level")
}

/// Atomic curriculum subject (§4.4b, R107–R108). The broad Quran domain القرآن
/// الكريم is not a row: أحكام القرآن, حفظ القرآن, ترتيل وتجويد القرآن, and
/// تفسير القرآن are separate schedulable Subjects. Memorisation stays
/// exclusively in the §4.5 Surah + ayah-range engine (BR-13, §20 rule 23).
model Subject {
  id                  String                     @id @default(uuid()) @db.Uuid
  teacherCapabilities TeacherSubjectCapability[]
  name                String                     @db.VarChar(120)
  displayOrder        Int?                       @map("display_order")

  /// R73/R107–R108 — **which Subject's teaching authorises Quran memorisation**
  /// (§4.5, TD-2). It belongs only to حفظ القرآن.
  ///
  /// §4.4c's *own students* is subject-blind, so without this a مؤطرة teaching
  /// only Fiqh could log a مستفيدة's memorization. Matching on the NAME is
  /// prohibited: R27 made Subjects editable reference data and §4.4b requires
  /// rules *"checked generically … rather than hardcoded against a level name"*.
  ///
  /// **At most one LIVE Subject may carry it** — a partial unique index in SQL,
  /// because §4.5's engine is singular and two would make *which* teaching
  /// authorises a log ambiguous. The Production seed establishes exactly one;
  /// absence remains representable and fails closed before bootstrap. It
  /// configures nothing else: no tracking mode, no second engine, and no
  /// `subject_id` on `QuranProgressLog`.
  tracksQuranProgress Boolean @default(false) @map("tracks_quran_progress")

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  levels LevelSubject[]

  // Revision 43 (expand phase) — see the educational-model block below.
  teachingGroups     TeachingGroup[]
  courseSchedules    RecurringCourseSchedule[]
  teachingGroupSeats StudentTeachingGroup[]
  exams              Exam[]
  content            EducationalContent[]

  @@index([displayOrder])
  @@map("subject")
}

/// Creating a row auto-creates draft grading components (BR-9).
model LevelSubject {
  id        String  @id @default(uuid()) @db.Uuid
  levelId   String  @map("level_id") @db.Uuid
  level     Level   @relation(fields: [levelId], references: [id], onDelete: Restrict)
  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([levelId, subjectId])
  @@map("level_subject")
}

/// The Surahs selected per Level for حفظ القرآن memorisation (R107); the
/// separate, unmarked تفسير القرآن curriculum follows the same selection.
/// Only حفظ uses these rows for §4.5 progress and BR-11 completion. When the
/// postponed grading-template engine is built, a Women's-level row generates
/// `[Surah] Memorization` and `[Surah] Tafsir` components (§4.6, BR-9).
model LevelSurah {
  id      String     @id @default(uuid()) @db.Uuid
  levelId String     @map("level_id") @db.Uuid
  level   Level      @relation(fields: [levelId], references: [id], onDelete: Restrict)
  surahId Int        @map("surah_id")
  surah   QuranSurah @relation(fields: [surahId], references: [surahId], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([levelId, surahId])
  @@map("level_surah")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Revision 43 — educational model: ORGANISATION and DELIVERY
//
// EXPAND PHASE (TD-6b). These tables live ALONGSIDE `Group`, `GroupTeacher`,
// `StudentGroup` and `EventGroup` until the migrate phase has backfilled them
// and no released code reads the old ones. The contract migration that drops
// the old structures is a SEPARATE, LATER migration — never the same one.
// ---------------------------------------------------------------------------

/// §4.4c — the permanent ORGANISATIONAL unit inside a Level.
///
/// Carries level + branch + name and NOTHING ELSE. No room, no teacher, no
/// assistant, no schedule, **no capacity** — every one of those belongs to
/// delivery, and re-adding any of them rebuilds the exact conflation Revision
/// 43 removed (§20 rule 22).
///
/// **`branchId` stays here and is load-bearing.** It is the single answer to
/// *"which branch is this person at"* — the answer `User.intended_branch_id`
/// deliberately does NOT give, since that records only what an applicant asked
/// for (§4.1). Staff branch scoping, the §4.9 Global-content rule, and the
/// §5.2 library ordering all resolve through it.
model AdministrativeGroup {
  exams    Exam[]
  id       String @id @default(uuid()) @db.Uuid
  /// Collated `ar-x-icu` in SQL (TD-6a) — BR-19 ordering is not a per-query concern.
  name     String @db.VarChar(120)
  levelId  String @map("level_id") @db.Uuid
  level    Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// CHECK (>= 0) in SQL.
  displayOrder Int? @map("display_order")

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  enrollments Enrollment[]
  schedules   RecurringCourseSchedule[]
  grades      Grade[]
  eventScopes EventAdministrativeGroup[]

  // Redundant against the primary key ON PURPOSE: PostgreSQL requires a unique
  // constraint on the referenced column pair before `Enrollment` can declare
  // its composite FK `(administrative_group_id, level_id)`. That FK is what
  // makes `Enrollment.level_id` a CONSTRAINT rather than a copy that drifts.
  // Never remove it to "tidy up" (§20 rule 22).
  @@unique([id, levelId], map: "administrative_group_id_level_id_key")
  /// Revision 66 — redundant against the primary key ON PURPOSE, exactly as the
  /// pair above is: PostgreSQL requires a unique constraint on the referenced
  /// columns before `Enrollment` can declare its composite FK
  /// `(administrative_group_id, branch_id)`. That FK is what makes the
  /// enrolment's branch provably the group's rather than a copy that drifts.
  /// Never remove it to "tidy up" (§20 rule 22).
  @@unique([id, branchId], map: "administrative_group_id_branch_id_key")
  @@index([levelId, deletedAt])
  @@index([branchId, deletedAt])
  @@map("administrative_group")
}

/// §4.4c — a subject-specific split inside a Level.
///
/// Belongs to a Subject and a Level, **never to an AdministrativeGroup**, and
/// exists ONLY where a Subject needs students divided differently from the
/// administrative roster. A Subject with no rows here is taught to the entire
/// Level; creating these is not a prerequisite for teaching.
///
/// Splits are INDEPENDENT BETWEEN SUBJECTS — one student may sit in
/// Administrative Group 1, حفظ القرآن Group 2 and ترتيل وتجويد القرآن Group 1 at once. That
/// independence comes from the per-(subject, level) uniqueness on the
/// membership join below, not from anything here.
model TeachingGroup {
  id        String  @id @default(uuid()) @db.Uuid
  /// Collated `ar-x-icu` in SQL (TD-6a).
  name      String  @db.VarChar(120)
  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  levelId   String  @map("level_id") @db.Uuid
  level     Level   @relation(fields: [levelId], references: [id], onDelete: Restrict)

  displayOrder Int? @map("display_order")

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  members   StudentTeachingGroup[]
  schedules RecurringCourseSchedule[]

  // Same technique as `AdministrativeGroup(id, level_id)`: the referenced pair
  // a composite FK needs. `StudentTeachingGroup` carries subject+level and this
  // is what forces them to agree with the group's own.
  @@unique([id, subjectId, levelId], map: "teaching_group_id_subject_id_level_id_key")
  @@index([subjectId, levelId, deletedAt])
  @@map("teaching_group")
}

/// §4.4c — membership of a subject-specific split.
///
/// **At most one row per (student, subject, level)** among non-deleted rows —
/// this is what makes the splits INDEPENDENT BETWEEN SUBJECTS: the uniqueness
/// is per subject, so one student sits in حفظ القرآن Group 2 and ترتيل وتجويد القرآن Group 1 at
/// once without either constraining the other.
///
/// `subjectId` and `levelId` are denormalized from the teaching group for
/// exactly the reason `Enrollment.levelId` is: **a PostgreSQL unique index
/// cannot join to another table**, so the constraint is inexpressible without
/// them. The composite FK `(teaching_group_id, subject_id, level_id) →
/// TeachingGroup(id, subject_id, level_id)` makes the database refuse a row
/// whose pair disagrees with its group's, so these are CONSTRAINTS, not copies.
///
/// Membership is OPTIONAL: a student in a Level whose Subject is split but who
/// holds no row here appears on that Subject's `unassigned` list (BR-22), never
/// silently classless.
model StudentTeachingGroup {
  id              String        @id @default(uuid()) @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  student         User          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teachingGroupId String        @map("teaching_group_id") @db.Uuid
  teachingGroup   TeachingGroup @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)

  /// Kept honest by the composite FK — never written independently.
  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  levelId   String  @map("level_id") @db.Uuid
  level     Level   @relation(fields: [levelId], references: [id], onDelete: Restrict)

  addedAt     DateTime  @default(now()) @map("added_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@index([teachingGroupId, deletedAt])
  @@index([studentId, deletedAt])
  @@index([subjectId, levelId, deletedAt])
  @@map("student_teaching_group")
}

/// §4.4c — a student's membership of a Level, through one Administrative Group.
/// Replaces `StudentGroup`.
///
/// **`levelId` is denormalized DELIBERATELY and is not a second source of
/// truth.** The composite FK `(administrative_group_id, level_id) →
/// AdministrativeGroup(id, level_id)`, added in SQL, makes the database REFUSE
/// a row whose level disagrees with its group's. That is what permits a real
/// partial `UNIQUE (student_id, level_id)` — the only way to enforce "exactly
/// one Administrative Group per enrolled Level" (BR-21) without a trigger.
///
/// Level membership is stored NOWHERE ELSE. The withdrawn `StudentLevel`
/// proposal would have been the second source of truth this design avoids.
model Enrollment {
  id                    String               @id @default(uuid()) @db.Uuid
  studentId             String               @map("student_id") @db.Uuid
  student               User                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  /// Revision 66 — NULLABLE. A Level that needs no subdivision needs no group,
  /// and a student may be enrolled in it directly. A Group is required only
  /// when the Level is actually subdivided, exactly as a Teaching Group is
  /// required only when a Subject is split.
  administrativeGroupId String?              @map("administrative_group_id") @db.Uuid
  administrativeGroup   AdministrativeGroup? @relation(fields: [administrativeGroupId], references: [id], onDelete: Restrict)
  /// Kept honest by the composite FK above — never written independently.
  levelId               String               @map("level_id") @db.Uuid
  level                 Level                @relation(fields: [levelId], references: [id], onDelete: Restrict)

  /// Revision 66 — **the single answer to *where is this student*.**
  ///
  /// It used to be reached through the group (`Enrollment →
  /// AdministrativeGroup.branch_id`), which is exactly why the group could not
  /// be optional: an ungrouped student would have had no branch, and Admin
  /// scoping, Teaching-Group placement (R43.3), the library's own-branch
  /// ordering and `entire_level` audiences all require one.
  ///
  /// The enrolment IS the operational assignment, and that is where a branch
  /// belongs — a Level spans branches, a placement does not. Agreement with a
  /// group's own branch is a CONSTRAINT rather than an intention: the composite
  /// FK `(administrative_group_id, branch_id)`, which PostgreSQL leaves
  /// unenforced when the group is NULL.
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  enrolledAt  DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  // Uniqueness is scoped to non-deleted rows → partial index in SQL (TD-6).
  @@index([administrativeGroupId, deletedAt])
  @@index([levelId, deletedAt])
  @@index([studentId, deletedAt])
  @@index([branchId, deletedAt])
  @@map("enrollment")
}

/// §4.4 — the unit of DELIVERY. Materializes `Session` rows.
///
/// Exactly one target FK is non-null and matches `teachingMode`, enforced by
/// CHECK in SQL. A schedule targets ONE entity: plural targeting buys nothing a
/// second row does not, while forcing the roster query, the conflict check and
/// the consent gate each to take a set where a single value suffices (§4.4c).
model RecurringCourseSchedule {
  /// R57 — what the class is CALLED, as opposed to what identifies it.
  /// Collated `ar-x-icu` in SQL (TD-6a). A label, never an identifier: not
  /// unique, and no part of conflict detection, recurrence, materialization,
  /// the R50 split or audience resolution.
  title       String  @db.VarChar(120)
  description String? @db.VarChar(2000)

  id        String  @id @default(uuid()) @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  teachingMode TeachingMode @map("teaching_mode")

  /// Exactly ONE of the three is non-null, matching `teachingMode` (CHECK).
  levelId               String?              @map("level_id") @db.Uuid
  level                 Level?               @relation(fields: [levelId], references: [id], onDelete: Restrict)
  administrativeGroupId String?              @map("administrative_group_id") @db.Uuid
  administrativeGroup   AdministrativeGroup? @relation(fields: [administrativeGroupId], references: [id], onDelete: Restrict)
  teachingGroupId       String?              @map("teaching_group_id") @db.Uuid
  teachingGroup         TeachingGroup?       @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)

  branchId String  @map("branch_id") @db.Uuid
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomId   String? @map("room_id") @db.Uuid
  room     Room?   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  /// **R97 — the DEFAULT delivery for every Session this schedule materializes.**
  ///
  /// A default, not historical truth: `session.materialize` snapshots it onto
  /// each occurrence exactly as it snapshots `room_id` (R43.4), and changing it
  /// later rewrites only the future, un-protected occurrences. October stays
  /// what October was.
  deliveryMode    DeliveryMode     @default(in_person) @map("delivery_mode")
  /// Non-null **iff** `deliveryMode` is `online` (CHECK
  /// `course_schedule_delivery_check`).
  onlineMediaMode OnlineMediaMode? @map("online_media_mode")

  /// Local Moroccan wall-clock, never UTC instants — Ramadan DST suspension
  /// would silently shift every class by an hour, twice a year (TD-11,
  /// §20 rule 14).
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  /// **R109 — the DEFAULT visibility for every Session this schedule
  /// materializes.**
  ///
  /// A default, not the occurrence's truth: `session.materialize` snapshots it
  /// onto each occurrence exactly as it snapshots `room_id` (R43.4) and
  /// `delivery_mode` (R97), and changing it later rewrites only the future,
  /// un-protected occurrences. A class hidden in November leaves October's
  /// occurrences saying what October actually was.
  ///
  /// `public` is the default because R43 made the timetable browsable by
  /// anonymous visitors, and every schedule that existed before this revision
  /// was public in fact.
  visibility Visibility @default(public)

  /// Shared vocabulary (§4.4). `none` is PROHIBITED here (CHECK) — a
  /// non-recurring occurrence is an Event.
  recurrence RecurrenceType

  /// Used by weekly / multiple_weekdays / biweekly_alternating. One element for
  /// `weekly`, several for `multiple_weekdays`.
  weekdays    DayOfWeek[] @map("weekdays")
  /// Used by monthly / yearly.
  dayOfMonth  Int?        @map("day_of_month")
  monthOfYear Int?        @map("month_of_year")
  /// The week `biweekly_alternating` counts from — without an anchor, "week on"
  /// is undefined and the two halves of the alternation are indistinguishable.
  anchorDate  DateTime?   @map("anchor_date") @db.Date

  /// The last date this recurrence produces occurrences for (SRS Revision 50).
  /// **NULL is open-ended**, which every schedule created before R50 is. Set
  /// when a schedule is SPLIT for a "this and all future" edit: the current
  /// schedule is closed here and a successor is anchored at the split date.
  /// With `anchor_date` it bounds one series. A calendar date, not an instant
  /// (TD-11) — a schedule ends after a day's classes.
  effectiveUntil DateTime? @map("effective_until") @db.Date

  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  staff    CourseScheduleStaff[]
  sessions Session[]

  @@index([branchId, deletedAt])
  @@index([subjectId, deletedAt])
  @@index([academicYearId, deletedAt])
  @@map("recurring_course_schedule")
}

/// **SRS Revision 92 — one occurrence's audience, when it is not its schedule's.**
///
/// The association occasionally delivers a lesson once instead of twice: two
/// branches' classes meet together, physically at one of them, for that
/// occurrence only.
///
/// **Semantics are REPLACEMENT, not addition:**
///
/// * no rows for a Session → its audience is inherited from its CourseSchedule;
/// * rows exist → they **are** that Session's audience branches.
///
/// An additive reading would leave nobody able to say whether the schedule's own
/// branch is still included. The interface seeds an override with the inherited
/// branch already chosen, so *combine* is expressed by adding the second — the
/// same thing, said unambiguously.
///
/// **Scope, not a roster** (§20 rule 22): the branch populations are resolved
/// against live Enrollments at read time, exactly as every other audience is. A
/// stored roster would diverge from the group it came from the moment anybody
/// enrolled or moved.
///
/// **The physical venue is a different fact** and is untouched: a Session
/// happens where its schedule's branch and its own room say. This says who is
/// expected there.
model SessionAudienceBranch {
  sessionId String  @map("session_id") @db.Uuid
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  branchId  String  @map("branch_id") @db.Uuid
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The pair IS the fact: naming one branch twice for one occurrence is not two
  /// statements. No soft delete — removing a branch is a correction to a plan,
  /// not an event with a history, and the audit row records who made it.
  @@id([sessionId, branchId])
  @@index([branchId])
  @@map("session_audience_branch")
}

/// §4.4c — **the resolution table for ALL teacher scoping.** Replaces
/// `GroupTeacher`.
///
/// A teacher's reach is the union of the resolved audiences of the schedules
/// they staff, and `schedule.branch_id` states their branch scope DIRECTLY,
/// where the retired path inferred it through two hops. The rule itself lives
/// in §4.4c and in `policies/` — this model only holds the rows.
model CourseScheduleStaff {
  id         String                  @id @default(uuid()) @db.Uuid
  scheduleId String                  @map("schedule_id") @db.Uuid
  schedule   RecurringCourseSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  userId     String                  @map("user_id") @db.Uuid
  user       User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  position ScheduleStaffPosition

  /// **SRS Revision 91 — the assignment's effective period.**
  ///
  /// Calendar dates, never instants (TD-11): a replacement runs *from the 1st to
  /// the 30th* at each branch's own clock.
  ///
  /// **NULL is open-ended at that end**, and is the only ambiguity-free reading:
  /// `effective_from = NULL` means *from the schedule's own beginning* and
  /// `effective_until = NULL` means *through the schedule's own end* — which is
  /// itself possibly open (`RecurringCourseSchedule.effectiveUntil`). Every row
  /// written before R91 therefore keeps its exact meaning with **no backfill**,
  /// because a time-blind row already meant *the schedule's whole life*.
  ///
  /// Both bounds are INCLUSIVE. A single-day assignment sets them equal, which
  /// is how one covered lesson is expressed.
  effectiveFrom  DateTime? @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  /// **`@@unique([scheduleId, userId])` was withdrawn by R91.** It encoded *one
  /// person holds one position on one schedule*, true only while an assignment
  /// had no period — and it refuses the case R91 exists for: Safa until
  /// November, Amina for November, Safa again from December is two rows for
  /// Safa. The replacement rules are interval invariants and live in the
  /// service under TD-15.2's row lock: **no overlapping intervals for one
  /// person on one schedule**, and **at most one main teacher active on any
  /// date**.
  @@index([userId, deletedAt])
  @@index([scheduleId, deletedAt, effectiveFrom, effectiveUntil])
  @@index([scheduleId, userId, deletedAt])
  @@map("course_schedule_staff")
}

/// §4.4 — ONE materialized dated occurrence of a schedule.
///
/// Carries its OWN date, time, room and teacher, defaulted from the schedule
/// and individually overridable. That is what makes a cancellation, a room
/// change, a reschedule and a makeup class EDITS TO THIS ROW rather than a
/// parallel Event mechanism.
///
/// **The audience is NOT stored here** (§20 rule 22). It resolves from the
/// schedule's mode and target at read time; a snapshot would silently diverge
/// from the group it came from, which is the failure Revision 43 exists to
/// remove.
model Session {
  id         String                  @id @default(uuid()) @db.Uuid
  scheduleId String                  @map("schedule_id") @db.Uuid
  schedule   RecurringCourseSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  /// A calendar date, never an instant (TD-11).
  date      DateTime @db.Date
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  /// Snapshot at materialization (Revision 43.4), not re-derived from the
  /// schedule: a held session must stay historically correct.
  roomId String? @map("room_id") @db.Uuid
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  /// **R97 — how THIS occurrence was actually delivered.**
  ///
  /// Snapshot at materialization, on the same footing as `room_id` above and
  /// for the same reason: a class held online in October must still read as
  /// online after the schedule moves back into a room in November. An
  /// occurrence-only change is an ordinary `session.override`, so it sets
  /// `overridden` and is thereafter protected from resync — there is **no
  /// second override marker**, because the platform already has one.
  deliveryMode    DeliveryMode     @default(in_person) @map("delivery_mode")
  /// Non-null **iff** `deliveryMode` is `online` (CHECK
  /// `session_delivery_check`). An online occurrence additionally holds **no**
  /// `room_id` at all (CHECK `session_online_no_room_check`), which is what
  /// makes room-collision detection ignore it without a special case.
  onlineMediaMode OnlineMediaMode? @map("online_media_mode")

  /// **R109 — this occurrence's OWN visibility tier.**
  ///
  /// Snapshot at materialization, on the same footing as `room_id` (R43.4) and
  /// `delivery_mode` (R97), and for the same reason: a class hidden for one
  /// week must stay hidden for that week after the schedule goes public again.
  /// An occurrence-only change is an ordinary `session.override`, so it sets
  /// `overridden` and is thereafter protected from resync — there is **no
  /// second override marker**, because the platform already has one.
  visibility Visibility @default(public)

  status SessionStatus @default(scheduled)

  /// Distinguishes a human's deliberate change from a `session.materialize`
  /// default. This flag is what protects the row from the next schedule edit
  /// (§20 rule 24) — an overridden session is never rewritten or deleted.
  overridden Boolean @default(false)

  /// Mandatory on cancel (TD-8 `session.cancel`).
  cancellationReason String? @map("cancellation_reason") @db.VarChar(500)

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  linkedContent    SessionContent[]
  staff            SessionStaff[]
  notifications    Notification[]
  /// R92 — this occurrence's own audience branches, when it has them. Empty
  /// means *inherit from the schedule*, which is every occurrence but the rare
  /// combined one.
  audienceBranches SessionAudienceBranch[]
  /// R99 — attempts to record this occurrence. Usually none: recording is
  /// optional and explicit, and a class that nobody recorded has no rows here.
  recordings       SessionRecording[]

  // What makes `session.materialize` idempotent: a second run over the same
  // horizon creates no duplicate occurrence.
  @@unique([scheduleId, date])
  // What makes room conflict detection a lookup rather than a scan. The staff
  // side is indexed on `SessionStaff` below.
  @@index([roomId, date])
  @@index([date, status])
  /// R109 — the calendar reads a date window at a tier, exactly as `Event`'s
  /// `[start_date, visibility]` does.
  @@index([date, visibility])
  @@map("session")
}

/// §7 (Revision 43.4) — **the teaching assignment as it stood for ONE
/// occurrence.**
///
/// Mirrors `CourseScheduleStaff` exactly, and replaces the single
/// `Session.teacher_id`: the association co-teaches and classes have
/// assistants, so one column could not hold the answer, and keeping both a
/// column and a join would give *"who taught this"* two homes that drift.
///
/// **This is a snapshot, and that is the whole point.** Editing a schedule's
/// staff in June must not re-attribute March's classes to someone who never
/// taught them. Rows here are written by `session.materialize` for FUTURE
/// occurrences and by a deliberate override; a past or `held` session's rows are
/// never rewritten by a schedule edit (§4.4).
///
/// **Not in tension with §20 rule 22.** That rule bans snapshotting a session's
/// *audience*, because enrolment changes must be reflected live. Staffing is the
/// opposite kind of fact: what was arranged for this occurrence.
model SessionStaff {
  id        String  @id @default(uuid()) @db.Uuid
  sessionId String  @map("session_id") @db.Uuid
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  userId    String  @map("user_id") @db.Uuid
  user      User    @relation("SessionStaffUser", fields: [userId], references: [id], onDelete: Restrict)

  position ScheduleStaffPosition

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([sessionId, userId])
  // The teacher/assistant half of conflict detection: "is this person already
  // committed on this date" must be a lookup.
  @@index([userId, deletedAt])
  @@map("session_staff")
}

/// §4.9 — a Session REFERENCES content; it never owns it.
///
/// One semester PDF is referenced by every session that uses it, and unlinking
/// a session never deletes the file. Replaces the retired single
/// `EducationalContent.event_id`, which could express only one relationship, in
/// one direction, to the wrong entity.
/// **R99 — one attempt to record one online occurrence.**
///
/// ## Why this exists when R98 refused a room table
///
/// R98.2 refused an `OnlineRoom` table because a room has **no state that is
/// not derivable**: it opens on first join and closes when the last person
/// leaves. A recording is the opposite. It is started by a named person at a
/// named moment, it runs or fails, the provider reports on it asynchronously
/// and possibly more than once, and *«was this class recorded, by whom, and
/// what happened to it»* is a question asked long after every participant has
/// gone. None of that is derivable from anything.
///
/// ## What it is NOT
///
/// **It is not content.** A finished recording becomes an ordinary
/// `EducationalContent` with `origin = session_recording` plus a
/// `SessionContent` link (R99.9), and this row remains the **integration
/// state** that produced it. Keeping the two apart is what stops a provider's
/// vocabulary leaking into the content model — and what lets a failed
/// recording exist as an honest failure rather than as a broken library item
/// (R99.14).
///
/// **It is not on `Session`.** R97.9 forbids a provider identifier there, and
/// `providerEgressId` below is exactly such an identifier.
model SessionRecording {
  id        String  @id @default(uuid()) @db.Uuid
  sessionId String  @map("session_id") @db.Uuid
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  status RecordingStatus @default(starting)

  /// **The provider's own job id — integration state, and the idempotency key
  /// for every callback.** Nullable only in the instant between asking the
  /// provider and being told what it called the job; unique among live rows so
  /// a duplicate webhook delivery can never create a second recording (R99.15).
  providerEgressId String? @unique @map("provider_egress_id")

  /// Where the provider left its output. **Temporary, and never exposed as a
  /// content asset** (R99.13) — a URL whose lifetime the association does not
  /// control would rot silently inside the library.
  outputBucket String? @map("output_bucket") @db.VarChar(63)
  outputKey    String? @map("output_key")
  sizeBytes    BigInt? @map("size_bytes")
  durationMs   Int?    @map("duration_ms")
  /// What the provider actually produced — `video/mp4` for a صوت وصورة class,
  /// an audio type for صوت فقط (R99.7).
  mimeType     String? @map("mime_type") @db.VarChar(120)

  /// **Who chose to record.** R99.3 makes this a مؤطِّرة, an assistant with
  /// identical authority, or an administrator in scope — never a beneficiary.
  /// Kept because TD-8's audit answers *who did it* and this answers *whose
  /// class it was*, and the two are asked separately.
  startedById String   @map("started_by") @db.Uuid
  startedBy   User     @relation("RecordingStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  startedAt   DateTime @default(now()) @map("started_at") @db.Timestamptz(6)

  stoppedById String?   @map("stopped_by") @db.Uuid
  stoppedBy   User?     @relation("RecordingStoppedBy", fields: [stoppedById], references: [id], onDelete: Restrict)
  stoppedAt   DateTime? @map("stopped_at") @db.Timestamptz(6)

  /// Operator-facing, never rendered to a مؤطِّرة (TD-3.8's discipline): she is
  /// told the recording failed and what to do, not what the provider said.
  failureReason String? @map("failure_reason") @db.VarChar(500)

  /// **The library item this recording BECAME — and the durable idempotency
  /// anchor for the whole ingestion pipeline (R99.13, R99.15).**
  ///
  /// `NULL` until ingestion has genuinely succeeded, which is what makes
  /// R99.14 checkable rather than asserted: *available* is **derived from this
  /// column being set**, never stored as a second fact that could disagree with
  /// it. The provider saying `completed` means only that an object exists in
  /// staging.
  ///
  /// **Optional 1:1, and both halves earn their place.** Nullable, because most
  /// of a recording's life is spent before there is anything to point at.
  /// **Unique**, because a duplicate callback, a retried job and a redelivered
  /// webhook must all converge on **one** content row: if the column is already
  /// populated the worker returns what is there instead of ingesting again, and
  /// the index is what makes that true under concurrency rather than merely
  /// likely.
  ///
  /// `Restrict` rather than `Cascade`: deleting the library item must not
  /// silently erase the record that a class was recorded.
  educationalContentId String?             @unique @map("educational_content_id") @db.Uuid
  educationalContent   EducationalContent? @relation(fields: [educationalContentId], references: [id], onDelete: Restrict)

  /// **Why the last ingestion attempt failed** — operator-facing, and distinct
  /// from `failureReason` above, which is the PROVIDER's.
  ///
  /// The two are different events with different remedies: the provider failing
  /// to record means there is no artefact, while ingestion failing means there
  /// is one and the platform could not accept it. Collapsing them into one
  /// column would make *the recording failed* the answer to both, and only one
  /// of them is recoverable by retrying.
  ///
  /// Cleared on success, so a populated value always describes the CURRENT
  /// state rather than a historical attempt that later succeeded.
  ingestionFailureReason String? @map("ingestion_failure_reason") @db.VarChar(500)

  version Int @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // The classroom asks "is this occurrence recording right now" on every read.
  @@index([sessionId, status])
  @@map("session_recording")
}

model SessionContent {
  id        String             @id @default(uuid()) @db.Uuid
  sessionId String             @map("session_id") @db.Uuid
  session   Session            @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  contentId String             @map("educational_content_id") @db.Uuid
  content   EducationalContent @relation(fields: [contentId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([sessionId, contentId])
  @@index([contentId, deletedAt])
  @@map("session_content")
}

/// Event scope join over organisational groups (Revision 43 — replaces
/// `EventGroup`). Events scope to Administrative Groups, never to Teaching
/// Groups: an event is not subject-specific.
model EventAdministrativeGroup {
  id                    String              @id @default(uuid()) @db.Uuid
  eventId               String              @map("event_id") @db.Uuid
  event                 Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  administrativeGroupId String              @map("administrative_group_id") @db.Uuid
  administrativeGroup   AdministrativeGroup @relation(fields: [administrativeGroupId], references: [id], onDelete: Restrict)

  @@unique([eventId, administrativeGroupId])
  @@index([administrativeGroupId])
  @@map("event_administrative_group")
}

// ---------------------------------------------------------------------------
// Family & consent (safeguarding)
// ---------------------------------------------------------------------------

/// THE authorization record checked by the `X-Active-Child-ID` middleware on
/// every child-scoped request (§4.3). Matching the child alone is never
/// sufficient — both parent and child must match an Approved row (§20 rule 6).
model FamilyLink {
  id        String           @id @default(uuid()) @db.Uuid
  parentId  String           @map("parent_id") @db.Uuid
  parent    User             @relation("FamilyLinkParent", fields: [parentId], references: [id], onDelete: Restrict)
  studentId String           @map("student_id") @db.Uuid
  student   User             @relation("FamilyLinkChild", fields: [studentId], references: [id], onDelete: Restrict)
  status    FamilyLinkStatus @default(pending)

  /// R62. Nullable because rows predating the revision have no value and
  /// guessing one would be a fabrication about a family.
  relationshipType RelationshipType? @map("relationship_type")

  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedById    String?   @map("decided_by") @db.Uuid
  decisionReason String?   @map("decision_reason") @db.VarChar(500)

  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Revision 68 — **a non-blocking review item, not a status.**
  ///
  /// Stamped on every approved live link of a student when that student binds
  /// their FIRST `UserIdentity` (§4.3, R62.9): a minor with parents attached
  /// has become a person with their own login, and an administrator decides
  /// whether the links stand. Cleared when they do.
  ///
  /// **Nothing reads it for authorization.** The links keep working, the
  /// student keeps their login, and `bindIdentity` cannot fail because of it —
  /// which is what "non-blocking" has to mean to be worth the word.
  ///
  /// A separate nullable timestamp rather than a `status` value, because the
  /// status is a decided value (TD-1): overloading it would make "is this link
  /// approved" and "has anyone looked at this" one question.
  identityReviewRaisedAt DateTime? @map("identity_review_raised_at") @db.Timestamptz(6)

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  // Uniqueness is scoped to non-deleted rows → partial index in SQL (TD-6).
  @@index([parentId, status])
  @@index([studentId, status])
  /// R68 — the queue derives its items from this, so the lookup is indexed.
  @@index([identityReviewRaisedAt])
  @@map("family_link")
}

/// One row per consent decision. Consent is NEVER a boolean on the user row
/// (§20 rule 2); absence of a record means NO consent (BR-1). History is
/// preserved — revocation is a state change with its own actor and timestamp.
/// R62 — one child in a parent's registration request.
///
/// ## Why the child `User` is not created here
///
/// Today's parent+child registration creates the child at submission, and that
/// is exactly what forces approval to be all-or-nothing: a rejected child would
/// otherwise leave an orphan account. Deferring creation to approval is what
/// makes per-child decisions clean — and it means **a rejected child leaves no
/// `User` row and no `FamilyLink` at all**, so partial approval cannot expose
/// one. The safety property is structural rather than enforced.
///
/// ## Consent is captured here and materialised at approval
///
/// `ConsentRecord.student_id` cannot be written before the student exists, so
/// the decisions travel on this row — including **the consent text version in
/// force at SUBMISSION**. `legal.consent_text_version` is a Super-Admin-editable
/// setting: materialising with the current value would record that a parent
/// consented to text they never saw, which §4.1a forbids.
model ChildApplication {
  id String @id @default(uuid()) @db.Uuid

  /// Groups the children submitted together. One request, many applications,
  /// each decided on its own.
  requestId String @map("request_id") @db.Uuid

  /// The requesting adult — a pending applicant or an already-approved account.
  parentId String @map("parent_id") @db.Uuid
  parent   User   @relation("ChildApplicationParent", fields: [parentId], references: [id], onDelete: Restrict)

  /// NULL until approved. Set to the created or matched child.
  childUserId String? @map("child_user_id") @db.Uuid
  childUser   User?   @relation("ChildApplicationChild", fields: [childUserId], references: [id], onDelete: Restrict)

  firstNameArabic String          @map("first_name_arabic") @db.VarChar(60)
  lastNameArabic  String          @map("last_name_arabic") @db.VarChar(60)
  sex             Sex?
  schoolingStage  SchoolingStage? @map("schooling_stage")

  /// The stage the parent is applying to — the administrator may change it
  /// (R62.7: placement is an administrative decision).
  requestedCategoryId String?   @map("requested_category_id") @db.Uuid
  requestedCategory   Category? @relation(fields: [requestedCategoryId], references: [id], onDelete: Restrict)

  /// Revision 64 — THE BRANCH ASKED FOR, for THIS child.
  ///
  /// Revision 39 put `intended_branch_id` on the applicant's `User` row and
  /// said it is written on the applicant only, never copied onto the child —
  /// correct while a registration always created a parent row, and a dead end
  /// once the parent already exists. A second child therefore arrived naming no
  /// branch at all. Recording it here also lets two siblings be asked for at
  /// different branches, which one parent-level column could not express.
  ///
  /// A REQUEST, never a placement (Revision 39's rule, unchanged): nothing
  /// reads it to choose, validate or refuse anything. Nullable because
  /// applications submitted before this revision have no answer, and *not
  /// stated* is a real state rather than a missing one.
  requestedBranchId String? @map("requested_branch_id") @db.Uuid
  requestedBranch   Branch? @relation(fields: [requestedBranchId], references: [id], onDelete: Restrict)

  /// R62.3b — as given at submission, never re-read at approval.
  consentDataProcessing Boolean  @map("consent_data_processing")
  consentMediaRelease   Boolean  @map("consent_media_release")
  consentTextVersion    String   @map("consent_text_version") @db.VarChar(60)
  consentGivenAt        DateTime @map("consent_given_at") @db.Timestamptz(6)

  status ChildApplicationStatus @default(pending)

  /// The account an administrator chose to link instead of creating a new one.
  /// **Never set automatically** — there is no natural key for a child, and
  /// matching on names alone would eventually attach one to the wrong family.
  matchedExistingUserId String? @map("matched_existing_user_id") @db.Uuid
  matchedExistingUser   User?   @relation("ChildApplicationMatch", fields: [matchedExistingUserId], references: [id], onDelete: Restrict)

  /// Bounded, and the only reason a parent is shown.
  rejectionReason ChildApplicationRejectionReason? @map("rejection_reason")
  /// Staff only. **Never returned to a parent in any payload.**
  internalNote    String?                          @map("internal_note") @db.VarChar(500)

  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedById String?   @map("decided_by") @db.Uuid
  decidedBy   User?     @relation("ChildApplicationDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  /// The queue reads pending applications by request; the parent reads their own.
  @@index([requestId])
  @@index([parentId, status])
  @@index([requestedBranchId])
  @@index([status, createdAt])
  @@map("child_application")
}

model ConsentRecord {
  id          String        @id @default(uuid()) @db.Uuid
  studentId   String        @map("student_id") @db.Uuid
  student     User          @relation("ConsentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  consentType ConsentType   @map("consent_type")
  granted     Boolean
  method      ConsentMethod

  /// The exact legal text version agreed to (§2.3, §4.1a).
  consentTextVersion String @map("consent_text_version") @db.VarChar(60)

  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByUserId String    @map("granted_by_user_id") @db.Uuid
  grantedBy       User      @relation("ConsentGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokedBy       User?     @relation("ConsentRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([studentId, consentType, grantedAt])
  @@map("consent_record")
}

/// Replay guard for single-use onboarding tokens. The `jti` insert happens
/// INSIDE the registration transaction (§4.1b step 5, TD-4.1): a replayed
/// token hits this unique constraint, the transaction aborts, and the request
/// fails with 409 STATE_CONFLICT.
model ConsumedToken {
  id         String               @id @default(uuid()) @db.Uuid
  jti        String               @unique
  purpose    ConsumedTokenPurpose
  consumedAt DateTime             @default(now()) @map("consumed_at") @db.Timestamptz(6)
  /// Rows past this horizon are removed by the daily `token.purge` job (TD-7).
  expiresAt  DateTime             @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("consumed_token")
}

/// Why a session is dead (§7, Revisions 16, 101 and 102). `reuse_detected` is
/// a security event — a rotated token was replayed outside the grace window.
enum RefreshRevokedReason {
  logout
  suspension
  user_deleted
  reuse_detected
  cookie_path_migration
  rejection

  @@map("refresh_revoked_reason")
}

/// Stable database lock target for one refresh-token rotation chain (R101).
///
/// Token rows are generations and may be inserted by rotation or deleted by
/// `token.purge`, so they cannot by themselves serialize the session at
/// PostgreSQL READ COMMITTED. This row carries no credential or revocation
/// state; it exists only for the lifetime of the chain and is removed once the
/// last token row has been purged.
model RefreshSession {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tokens RefreshToken[]

  @@index([userId])
  @@map("refresh_session")
}

/// One row per ISSUED refresh token (§7, Revision 16). This is the server-side
/// state TD-12 requires: rotation on use, the revocation list, immediate
/// revocation on suspension, and the 10-second predecessor grace window.
///
/// Deliberately absent, each evaluated and rejected in §7: `created_at` (same
/// instant as `issuedAt`), `revoked_by` (duplicates `AuditLog.actorUserId`),
/// `created_by_ip` / `user_agent_hash` (personal data, no MVP consumer, no
/// retention rule), `last_used_at` (derivable from the successor's `issuedAt`
/// under mandatory rotation). Do not re-add them without an SRS revision.
model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Stable id of one rotation CHAIN, stamped on the first token and copied to
  /// every successor. Makes "revoke this session" (logout) and "revoke the
  /// whole chain" (reuse detected) single indexed UPDATEs — walking
  /// `rotatedFromId` would need a recursive CTE, and §16.2 permits raw SQL
  /// only for row locks and pg-boss inserts.
  sessionId String         @map("session_id") @db.Uuid
  session   RefreshSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  /// Hashed, NEVER raw (TD-12): a stolen database dump must not yield usable
  /// 30-day credentials. Unique (TD-6).
  tokenHash String @unique @map("token_hash")

  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// 30-day TTL (TD-12) and the `token.purge` horizon (TD-7).
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// The immediate predecessor. This one field decides all three refresh
  /// outcomes: current → rotate; immediate predecessor inside 10 s → accept
  /// without re-rotating; anything older → reuse detected (TD-12).
  rotatedFromId String?       @unique @map("rotated_from_id") @db.Uuid
  rotatedFrom   RefreshToken? @relation("RefreshRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo     RefreshToken? @relation("RefreshRotation")

  /// The revocation-list check is `revokedAt IS NULL`.
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason RefreshRevokedReason? @map("revoked_reason")

  @@index([userId, revokedAt])
  @@index([sessionId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_token")
}

/// Authoritative store for per-user quotas that Nginx cannot enforce (§3.1,
/// §7, Revision 14). `limit_req` keys on connection variables and cannot read
/// a JWT subject, and its grammar admits only r/s and r/m, so an hourly
/// per-user quota has no representation at the edge.
///
/// The counter is locked and incremented INSIDE the transaction of the action
/// it gates (TD-4.12, TD-15.2) — evaluating the count outside would let two
/// concurrent initiations both pass at the limit boundary. Never held in
/// process memory (dies with the container, wrong across replicas) and never
/// routed through pg-boss (a job queue is asynchronous; this decision must be
/// synchronous). Elapsed windows are removed by `ratelimit.purge` (TD-7).
model RateLimitCounter {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Names the quota. MVP: `upload.initiate` (30/hour, TD-13).
  bucket String @db.VarChar(60)

  /// Truncated start of the fixed window.
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// The unique key is what makes the increment safe under concurrency (TD-6).
  @@unique([userId, bucket, windowStart])
  @@index([windowStart])
  @@map("rate_limit_counter")
}

/// Restricted case-file data (BR-16, §4.10). Field-level access: Admins and
/// the student's specifically-assigned teachers only — never other students,
/// unrelated guardians, or teachers at large.
model StudentSocialProfile {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @unique @map("student_id") @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  healthCondition  String? @map("health_condition") @db.VarChar(2000)
  familySituation  String? @map("family_situation") @db.VarChar(2000)
  homeAddress      String? @map("home_address") @db.VarChar(2000)
  siblingsCount    Int?    @map("siblings_count")
  fatherName       String? @map("father_name") @db.VarChar(120)
  fatherProfession String? @map("father_profession") @db.VarChar(120)
  motherName       String? @map("mother_name") @db.VarChar(120)
  motherProfession String? @map("mother_profession") @db.VarChar(120)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@map("student_social_profile")
}

// ---------------------------------------------------------------------------
// Calendar — the exception layer over Groups' fixed weekly schedules (§4.4)
// ---------------------------------------------------------------------------

/// **R110 — the scheduling-type catalogue: seeded reference data, not a
/// frontend constant.**
///
/// The five types lived in `frontend/src/adapters/scheduling-types.ts` as a
/// hardcoded registry, so the Owner could not add one, rename one, reorder them
/// or say which of them takes attendance. **Seeded does not mean immutable**
/// (Owner addendum, 2026-08-26): the seed is the initial state, never a
/// whitelist.
///
/// ## R56 refused this column, and named the condition for adding it
///
/// R56 declined `Event.type` because *"the category would drive no rule, no
/// job, no report"* — and said in terms that *"it may be added when filtering or
/// reporting by category becomes a real requirement."* `attendance_required` is
/// that requirement: it drives the form (OD-03). The condition R56 set is met,
/// so this is the clause being exercised rather than contradicted.
///
/// ## Deletion is refused, never cascaded
///
/// A historical Event must still resolve its type after the type is retired, so
/// `Event.scheduling_type_id` is `Restrict` and deletion is TD-5 soft with a
/// blocked-delete check (`assertNoBlockingReferences`). A hard delete would
/// orphan the record of what an activity WAS.
model SchedulingType {
  id String @id @default(uuid()) @db.Uuid

  /// The administrator-facing name — «حصة دراسية», «عطلة». Collated `ar-x-icu`
  /// in SQL (TD-6a), and **unique among live rows** (partial index): two types
  /// with one name is a picker with two identical options.
  name String @db.VarChar(60)

  /// Which entity it routes to. Stored, never inferred (see the enum).
  structuralKind SchedulingStructuralKind @map("structural_kind")

  /// **Whether attendance is taken for this type.** Structural data: the form
  /// presents attendance-specific controls only where this is true (OD-03), so
  /// it is a column and not display text. It is not derivable from the name —
  /// اختبار takes attendance and محاضرة does not, and nothing about either word
  /// says so.
  attendanceRequired Boolean @map("attendance_required")

  /// The Owner calls the order canonical, so it is a column an administrator
  /// can change — not the order the rows happen to have been inserted in.
  /// `NOT NULL` here, unlike `Subject.display_order`: this catalogue is seeded
  /// complete and ordered, so *unordered* is not a state it ever has.
  displayOrder Int @map("display_order")

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  events Event[]

  @@index([displayOrder])
  @@map("scheduling_type")
}

model Event {
  id          String     @id @default(uuid()) @db.Uuid
  title       String     @db.VarChar(120)
  description String?    @db.VarChar(2000)
  /// **R109 — the default is `public`, for NEW rows only.**
  ///
  /// It was `private`, which made *«an activity nobody outside the office can
  /// see»* the thing an administrator got by not choosing. The association's
  /// activities are announcements far more often than they are secrets, so the
  /// unchosen value is now the announcing one. **Existing rows keep whatever
  /// they hold** — a default governs inserts, and rewriting stored tiers would
  /// have published things somebody deliberately hid.
  visibility  Visibility @default(public)

  /// Local wall-clock date/time fields (TD-11) — never UTC instants.
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  startTime DateTime? @map("start_time") @db.Time(0)
  endTime   DateTime? @map("end_time") @db.Time(0)

  recurrenceType    RecurrenceType @default(none) @map("recurrence_type")
  recurrenceEndDate DateTime?      @map("recurrence_end_date") @db.Date

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  /// **R110 — which catalogue type this activity is** (محاضرة, حفل, عطلة).
  ///
  /// **Nullable, and it stays nullable**: R56 told administrators to write عطلة
  /// in the title, so every event created before this revision has a type
  /// recorded nowhere a query can reach. Inferring one from the title would be
  /// exactly the name-matching §4.4b forbids, and NEW L's normalization protocol
  /// refuses to invent data. **Required at the write boundary**, which is §7's
  /// standing division (R35) — nullable in the database for rows that predate
  /// the requirement, demanded where a real value can be asked for.
  ///
  /// `Restrict`: a retired type must still be resolvable by the activities that
  /// used it.
  schedulingTypeId String?         @map("scheduling_type_id") @db.Uuid
  schedulingType   SchedulingType? @relation(fields: [schedulingTypeId], references: [id], onDelete: Restrict)

  /// R71 — who is responsible for it, and who assists. An event had an
  /// audience and nobody answerable for it, which left a مؤطرة running a
  /// celebration with no way to be recorded and — because event scope derived
  /// from TEACHING schedules — no way to manage it.
  staff EventStaff[]

  branchScopes   EventBranch[]
  categoryScopes EventCategory[]
  levelScopes    EventLevel[]

  // Revision 43 (expand phase) — see the educational-model block below.
  administrativeGroupScopes EventAdministrativeGroup[]

  /// R82 — the notices sent about this event, if the actor chose to send any.
  notifications Notification[]

  @@index([startDate, visibility])
  @@map("event")
}

// The four scope joins are populated EXPLICITLY at event creation — never
// evaluated as runtime null/wildcard matches (§4.4).

model EventBranch {
  eventId  String @map("event_id") @db.Uuid
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([eventId, branchId])
  @@map("event_branch")
}

model EventCategory {
  eventId    String   @map("event_id") @db.Uuid
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([eventId, categoryId])
  @@map("event_category")
}

model EventLevel {
  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  levelId String @map("level_id") @db.Uuid
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)

  @@id([eventId, levelId])
  @@map("event_level")
}

// ---------------------------------------------------------------------------
// Quran memorization (§4.5)
// ---------------------------------------------------------------------------

/// Static pre-seeded lookup, all 114 rows (§15.1). The ONLY entity with a
/// natural key rather than a UUID (§16.2). `totalAyahs` is the definitive
/// denominator for coverage.
model QuranSurah {
  surahId            Int    @id @map("surah_id")
  nameArabic         String @map("name_arabic") @db.VarChar(120)
  nameTransliterated String @map("name_transliterated") @db.VarChar(120)
  totalAyahs         Int    @map("total_ayahs")

  logs     QuranProgressLog[]
  progress StudentSurahProgress[]
  levels   LevelSurah[]
  exams    Exam[]

  @@map("quran_surah")
}

/// Discrete closed ayah ranges. Any create/update/soft-delete triggers
/// SYNCHRONOUS per-surah recalculation in the same request — never a
/// background job (§4.5, BR-13, §20 rule 1).
model QuranProgressLog {
  id        String     @id @default(uuid()) @db.Uuid
  studentId String     @map("student_id") @db.Uuid
  student   User       @relation("QuranLogStudent", fields: [studentId], references: [id], onDelete: Restrict)
  surahId   Int        @map("surah_id")
  surah     QuranSurah @relation(fields: [surahId], references: [surahId], onDelete: Restrict)

  /// CHECK (start_ayah >= 1 AND start_ayah <= end_ayah) in SQL; the upper
  /// bound against `total_ayahs` crosses tables and is enforced by a trigger
  /// plus the service layer (TD-6).
  startAyah Int              @map("start_ayah")
  endAyah   Int              @map("end_ayah")
  category  QuranLogCategory

  loggedById String   @map("logged_by") @db.Uuid
  loggedBy   User     @relation("QuranLogLoggedBy", fields: [loggedById], references: [id], onDelete: Restrict)
  loggedAt   DateTime @default(now()) @map("logged_at") @db.Timestamptz(6)

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  // TD-6 names this composite explicitly as a hot path.
  @@index([studentId, surahId])
  @@index([studentId, surahId, deletedAt])
  @@map("quran_progress_log")
}

/// Self-healing coverage cache (§4.5). NEVER the source of truth — the logs
/// are. Every reader compares the stamp against the student+surah's latest log
/// and repairs the row in place on mismatch, which makes stale reads
/// structurally impossible (BR-13).
model StudentSurahProgress {
  id        String     @id @default(uuid()) @db.Uuid
  studentId String     @map("student_id") @db.Uuid
  student   User       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  surahId   Int        @map("surah_id")
  surah     QuranSurah @relation(fields: [surahId], references: [surahId], onDelete: Restrict)

  /// Union of merged, non-overlapping intervals. `mergedAyahCount` is the
  /// exact numerator; `coveragePercent` is Decimal (never float) so a 100.00
  /// comparison for level completion is exact (BR-11, BR-13).
  mergedAyahCount Int     @map("merged_ayah_count")
  coveragePercent Decimal @map("coverage_percent") @db.Decimal(5, 2)
  mergedIntervals Json    @map("merged_intervals") @db.JsonB

  /// Freshness stamp of the newest governing log (§4.5 read-side guard).
  lastLogId String?   @map("last_log_id") @db.Uuid
  lastLogAt DateTime? @map("last_log_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([studentId, surahId])
  @@map("student_surah_progress")
}

// ---------------------------------------------------------------------------
// Exams & grading (§4.6)
// ---------------------------------------------------------------------------

/// Exams are independent of calendar bounds. Every question in `questions`
/// carries an immutable auto-generated UUID; submissions reference those UUIDs
/// and never array positions (TD-6).
model Exam {
  id        String      @id @default(uuid()) @db.Uuid
  title     String      @db.VarChar(120)
  levelId   String      @map("level_id") @db.Uuid
  level     Level       @relation(fields: [levelId], references: [id], onDelete: Restrict)
  subjectId String?     @map("subject_id") @db.Uuid
  subject   Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  surahId   Int?        @map("surah_id")
  surah     QuranSurah? @relation(fields: [surahId], references: [surahId], onDelete: Restrict)

  /// R58 — the discriminator, not a flag. `physical` is organised in the
  /// platform; `online` is declared and refused until it is planned as its own
  /// feature. Fixed after creation: changing it would discard every column the
  /// other mode does not have.
  mode ExamMode @default(physical)

  description String? @db.VarChar(2000)

  /// R58 — a gap independent of the mode: content and course schedules both
  /// carry a year, and grades aggregate per year, yet an exam did not.
  academicYearId String?       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  date DateTime @db.Date

  /// R58, physical only — where it is sat and when. Wall-clock times (TD-11),
  /// never instants: an exam at 09:00 is at 09:00 at its branch.
  branchId  String?   @map("branch_id") @db.Uuid
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomId    String?   @map("room_id") @db.Uuid
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  startTime DateTime? @map("start_time") @db.Time(0)
  endTime   DateTime? @map("end_time") @db.Time(0)

  /// R58 — **NULL is the whole Level**, not "no target". A narrower audience
  /// when one group sits separately. The §4.4c three-mode target is deliberately
  /// not reused: an exam is sat by a roster at a premises, and the Teaching
  /// Group split has no bearing on who sits a paper.
  administrativeGroupId String?              @map("administrative_group_id") @db.Uuid
  administrativeGroup   AdministrativeGroup? @relation(fields: [administrativeGroupId], references: [id], onDelete: Restrict)

  staff ExamStaff[]

  round Int?

  accessPolicy ExamAccessPolicy @default(save_and_resume) @map("access_policy")

  /// R81 — **the maximum grade belongs to the exam**, and nothing else defines
  /// one. R58 refused this field as *"a second answer to what
  /// `grading.display_scale` already owns"*; the Owner retired that global
  /// scale, so the second answer became the only one. NUMERIC, not basis
  /// points: with a per-exam maximum there is nothing to normalise against, and
  /// exact decimal has no rounding site at all.
  maxGrade Decimal @map("max_grade") @db.Decimal(6, 2)

  /// **R109 — an exam has a visibility tier of its own**, superseding §4.6's
  /// *"it appears to the audience that can see the level it belongs to"*. A
  /// sitting is an arrangement the association may announce, keep to its
  /// members, or keep to the supervisor; nothing about the Level answered that.
  ///
  /// One column and no snapshot: an exam is one dated occurrence that
  /// materializes nothing (§4.6, R58), so there is no template/occurrence pair
  /// to keep in step.
  visibility Visibility @default(public)

  questions Json @db.JsonB

  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  submissions StudentExamSubmission[]
  grades      Grade[]

  /// R82 — `grade_published` notices about this exam.
  notifications Notification[]

  @@index([levelId, date])
  /// R58 — a physical sitting is read by *when and where*: the calendar asks
  /// for a date window at a branch, and the scheduling list asks the same.
  @@index([branchId, date])
  /// R109 — the calendar reads a date window at a tier, as `Session` and
  /// `Event` do.
  @@index([date, visibility])
  @@map("exam")
}

model StudentExamSubmission {
  id        String @id @default(uuid()) @db.Uuid
  examId    String @map("exam_id") @db.Uuid
  exam      Exam   @relation(fields: [examId], references: [id], onDelete: Restrict)
  studentId String @map("student_id") @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  /// Answers keyed by question UUID — never by array position (TD-6).
  answers Json @db.JsonB

  state SubmissionState @default(in_progress)

  /// Integer basis points, 0–10,000; CHECK enforced in SQL. No float score
  /// column exists anywhere (§4.6, §20 rule 3).
  autoScoreBp Int? @map("auto_score_bp")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("student_exam_submission")
}

/// Per student, per exam. MVP grades are per-exam and informational — there
/// are no averages and no template references (§4.6, Revision 12).
model Grade {
  id        String @id @default(uuid()) @db.Uuid
  examId    String @map("exam_id") @db.Uuid
  exam      Exam   @relation(fields: [examId], references: [id], onDelete: Restrict)
  studentId String @map("student_id") @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  /// Sitting provenance (Revision 43). The **Administrative Group** — the stable
  /// organisational unit that exists for every student in every enrolled Level.
  /// A Teaching Group exists only for split Subjects and would leave most
  /// sittings without provenance.
  administrativeGroupId String?              @map("administrative_group_id") @db.Uuid
  administrativeGroup   AdministrativeGroup? @relation(fields: [administrativeGroupId], references: [id], onDelete: Restrict)

  /// R81 — **the score itself**, on the exam's own scale: 15 of an exam whose
  /// `max_grade` is 20. Bounded by that maximum in the service, because a CHECK
  /// cannot reach another table.
  score  Decimal     @db.Decimal(6, 2)
  status GradeStatus @default(draft)

  /// BR-7: an enrolled student with no submission gets 0 flagged absent, and
  /// the row is initialized at the teacher's FIRST draft save so draft
  /// averages are never inflated by omission (§4.6).
  absent Boolean @default(false)

  /// TD-15: concurrent co-teacher scoring vs admin override must not clobber.
  version Int @default(0)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([examId, studentId])
  @@index([studentId, status])
  @@map("grade")
}

// ---------------------------------------------------------------------------
// Content & storage (§4.9)
// ---------------------------------------------------------------------------

model AcademicYear {
  exams     Exam[]
  id        String  @id @default(uuid()) @db.Uuid
  /// Validated `YYYY-YYYY`; free-text year strings are prohibited (§4.10).
  label     String  @unique @db.VarChar(9)
  /// Exactly one `true` row application-wide — partial unique index in SQL.
  isCurrent Boolean @default(false) @map("is_current")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  content EducationalContent[]

  // Revision 43 (expand phase) — see the educational-model block below.
  courseSchedules RecurringCourseSchedule[]

  @@map("academic_year")
}

model EducationalContent {
  id          String  @id @default(uuid()) @db.Uuid
  title       String  @db.VarChar(120)
  description String? @db.VarChar(2000)

  visibility Visibility @default(private)

  /// Maintained by the consent re-evaluation engine (§4.1a). Lifting it is
  /// Admin-only with a mandatory justification — Teachers never can
  /// (BR-3, §20 rule 7).
  consentForcedPrivate Boolean @default(false) @map("consent_forced_private")

  levelId String @map("level_id") @db.Uuid
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)

  /// NULL = the Global / بدون فرع scope. Assignable only by Admins and Super
  /// Admins; Teachers are locked to their own branch scope (BR-20, §4.9).
  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// Required (Revision 43): content belongs to a Subject as well as a Level.
  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  /// Immutable hash-segmented key (TD-9). Replacing a file mints a NEW key and
  /// quarantines the old object — keys are never reused or overwritten
  /// (§20 rule 15). Visibility is never encoded in the key; the bucket carries
  /// it.
  /// **R99 — «التسجيلات» is decided HERE, never by the MIME type.**
  ///
  /// Defaults to `uploaded`, which is what every pre-R99 row is by
  /// construction. The R99.11 backfill reclassifies exactly one set — audio
  /// carrying a live `SessionContent` link — because §4.9's MVP flow is a
  /// phone recording uploaded and attached, so those rows genuinely ARE class
  /// recordings and the screens have always shown them as such.
  origin ContentOrigin @default(uploaded)

  storageBucket    String @map("storage_bucket") @db.VarChar(20)
  storageKey       String @unique @map("storage_key")
  originalFilename String @map("original_filename")
  mimeType         String @map("mime_type") @db.VarChar(120)
  sizeBytes        BigInt @map("size_bytes")

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  sessionLinks SessionContent[]

  /// R99 — set only on an item the platform produced by recording a class, and
  /// at most one recording can have produced it (the unique side of the
  /// relation lives on `SessionRecording`).
  sessionRecording SessionRecording?

  @@index([levelId, academicYearId, branchId])
  @@index([visibility])
  @@map("educational_content")
}

// ---------------------------------------------------------------------------
// Platform: audit, trash, settings
// ---------------------------------------------------------------------------

/// Append-only accountability record (TD-8). No update or delete path exists
/// in the application. Distinct from `Trash`, which exists for restoration.
/// R58 — who supervises a physical sitting. The shape `CourseScheduleStaff`
/// already uses (§4.4c): one row per person, a position, soft-deletable.
model ExamStaff {
  id     String @id @default(uuid()) @db.Uuid
  examId String @map("exam_id") @db.Uuid
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  position ExamStaffPosition

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  /// One person holds one position on one exam.
  @@unique([examId, userId])
  @@index([userId])
  @@map("exam_staff")
}

/// R71 — who answers for an event. The shape `ExamStaff` and
/// `CourseScheduleStaff` already use: one row per person, a position, and a
/// tombstone rather than a delete.
///
/// **Reconciled by tombstone-and-revive (R59), never hard-deleted.** The unique
/// pair is deliberately NOT filtered on `deleted_at`, so a returning assistant
/// is revived rather than inserted — an insert would be refused. The
/// reconciliation is one field of an *update*, so it earns no Trash entry.
model EventStaff {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId  String @map("user_id") @db.Uuid
  user    User   @relation("EventStaffUser", fields: [userId], references: [id], onDelete: Restrict)

  position EventStaffPosition

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  /// One person holds one position on one event.
  @@unique([eventId, userId])
  /// "Which events does this مؤطرة answer for" is the scope query (R71.2).
  @@index([userId, deletedAt])
  @@map("event_staff")
}

model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  actionType   String  @map("action_type") @db.VarChar(60)
  targetEntity String? @map("target_entity") @db.VarChar(60)
  targetId     String? @map("target_id") @db.Uuid

  /// Includes mandatory justifications (consent-gate overrides, pass/fail
  /// overrides). Never PII beyond what TD-8 requires (TD-14).
  detail Json @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actionType, createdAt])
  @@index([targetEntity, targetId])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

/// JSON snapshot of any soft-deleted record, for restoration (§4.10, BR-15).
/// MVP restoration runs through the locked CLI script, never ad-hoc psql.
/// The 90-day window is enforced by `content.quarantine-purge` (TD-7).
model Trash {
  id           String @id @default(uuid()) @db.Uuid
  targetEntity String @map("target_entity") @db.VarChar(60)
  targetId     String @map("target_id") @db.Uuid

  /// Full row snapshot INCLUDING the cascaded relationship rows (FamilyLink,
  /// GroupTeacher, UserBranchRole, UserIdentity deactivations) — a User
  /// restored without them is a half-restored, silently broken account (§4.10).
  snapshot Json @db.JsonB

  deletedById String?  @map("deleted_by") @db.Uuid
  deletedBy   User?    @relation(fields: [deletedById], references: [id], onDelete: Restrict)
  deletedAt   DateTime @default(now()) @map("deleted_at") @db.Timestamptz(6)
  /// End of the 90-day permanent-delete window (BR-15).
  purgeAfter  DateTime @map("purge_after") @db.Timestamptz(6)

  @@index([targetEntity, targetId])
  @@index([purgeAfter])
  @@map("trash")
}

/// Application-level runtime config (TD-13): branding, legal/consent text
/// versions, Hijri day offset (−2…+2, CHECK in SQL), category default
/// visibilities, per-level passing defaults.
/// The official Moroccan Hijri calendar (SRS Revision 31, §4.4, §7).
///
/// One row per Hijri month, recording the Gregorian date on which that month
/// officially began according to the Ministry of Habous and Islamic Affairs.
/// This table is the SOLE source of every Hijri value the platform displays —
/// no caller computes one astronomically, and there is no day-offset.
///
/// Rows arrive either by manual entry or, later, by an automated import; both
/// write here, so the two paths cannot diverge.
model HijriMonthStart {
  id String @id @default(uuid()) @db.Uuid

  hijriYear  Int @map("hijri_year")
  /// 1–12.
  hijriMonth Int @map("hijri_month")

  /// Local calendar date (TD-11) — a `date`, never an instant.
  gregorianStartDate DateTime @map("gregorian_start_date") @db.Date

  /// Only `published` months are rendered anywhere, so a year can be entered
  /// progressively and reviewed before it becomes visible.
  status HijriMonthStatus @default(draft)

  /// The provenance of the row: `manual`, or an importer's source identifier.
  source String @default("manual") @db.VarChar(80)

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([hijriYear, hijriMonth])
  /// Resolution walks backwards from a Gregorian date to the month containing
  /// it, so this is the index that read path uses.
  @@index([gregorianStartDate])
  @@map("hijri_month_start")
}

enum HijriMonthStatus {
  draft
  published

  @@map("hijri_month_status")
}

model SystemSetting {
  key   String @id @db.VarChar(80)
  value Json   @db.JsonB

  version Int @default(0)

  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?  @map("updated_by") @db.Uuid

  @@map("system_setting")
}

/// **The one MVP notification event** (§4.8 as narrowed by Revision 77).
///
/// R6 removed in-app notifications from the MVP entirely, and R77 narrows that
/// to the *framework*: the five-event catalogue, the critical/normal tiers and
/// `NotificationPreference` stay in §10.1 and no schema may pre-create them.
/// This table is deliberately the minimum that can carry one event — **no tier,
/// no preference, no channel** — so it is not a head start on the postponed
/// design but a different, smaller thing.
///
/// A notification is a **delivered fact**, which is why it is a row and not a
/// derived read over cancelled sessions. Without a row there is nothing to mark
/// read, so a screen could only ever say *this class is cancelled* and never
/// *this is news*; and a student who left the Level would lose the notice of
/// last week's cancellation, which is exactly when they need it.
enum NotificationType {
  /// R82 — an Event was created, moved, or cancelled. Sending is the actor's
  /// decision, taken after the change is already saved; a reschedule is ONE
  /// notification and never a cancellation followed by a creation.
  event_created
  event_rescheduled
  event_cancelled
  /// R93 — a person was named on an event's staffing. **Not `event_created`**:
  /// that announces the activity to its audience, while this tells the person
  /// assigned that she is working on it, so she can say she is unavailable.
  /// Written when the assignment is committed, never as part of the optional
  /// audience announcement — the two are different meanings.
  event_staff_assigned
  /// R82 — a grade became visible to the student it is about (BR-8). Written at
  /// publication only, and idempotent across re-publication.
  grade_published
  session_cancelled
  session_restored
  /// R78.2 — a person was ADDED to a Session's staffing. Never written for a
  /// re-save that changes nothing: the `(user, session, type)` unique index
  /// makes that structural rather than a check.
  session_assigned
  /// R78.4 — an occurrence's date or time changed. The row points at the
  /// Session, so the notice always renders the CURRENT date and time; a second
  /// reschedule needs no second row, and the unique index gives that for free.
  session_rescheduled

  @@map("notification_type")
}

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Restrict)

  type NotificationType

  /// **Exactly one of the three is set** (R82) — a SQL CHECK enforces it, since
  /// a nullable column cannot say *and not the others*. Real foreign keys rather
  /// than a `target_type`/`target_id` pair: a polymorphic pair cannot be
  /// constrained by the database, and the three render from different includes.
  ///
  /// `Restrict` on all three, like every other reference to these rows: a notice
  /// whose subject vanished would be unreadable.
  sessionId String?  @map("session_id") @db.Uuid
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  /// R82 — an Event's creation, reschedule or cancellation.
  eventId String? @map("event_id") @db.Uuid
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  /// R82 — `grade_published`, written only at publication (BR-8), never at a
  /// draft save. It points at the EXAM rather than the Grade: the notice says a
  /// grade has been published, and her screen shows the current score.
  examId String? @map("exam_id") @db.Uuid
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: Restrict)

  /// Null until the recipient reads it. R77.5 turns on this column: an UNREAD
  /// notice of something no longer true is deleted on restore, while a READ one
  /// is answered with `session_restored` instead — silently removing something a
  /// person has already acted on is the worse failure.
  readAt DateTime? @map("read_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// One notification per recipient per target per type — what makes the write
  /// idempotent (R77.5, extended by R82). Cancelling twice, publishing twice, or
  /// a retry after a dropped response produces the same rows rather than a
  /// second copy of the same news.
  ///
  /// The event and exam equivalents are **partial** unique indexes declared in
  /// the R82 migration: a plain unique over a nullable column constrains nothing
  /// in PostgreSQL, because NULLs never collide.
  @@unique([userId, sessionId, type])
  /// The list read: one user's newest first (R77.6).
  @@index([userId, createdAt])
  @@map("notification")
}

/// **The teaching profile — what a مؤطِّرة CAN teach, and when** (R88).
///
/// **Planning data, and nothing else.** It exists so the administration can
/// choose assignments before the year starts; it grants no operational
/// authority whatever it says. Authority is `CourseScheduleStaff` and
/// `SessionStaff`, and this revision leaves both untouched.
///
/// Attached to `User` because `User` already IS the person: a مؤطِّرة may also
/// be a beneficiary (R79), and a second person entity would make one human two
/// rows. `position` on an assignment decides main teacher or assistant, so
/// there is one profile per person and no assistant variant.
model TeacherSubjectCapability {
  userId    String  @map("user_id") @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The pair IS the fact: declaring one Subject twice is not two declarations.
  @@id([userId, subjectId])
  @@index([subjectId])
  @@map("teacher_subject_capability")
}

model TeacherCategoryCapability {
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, categoryId])
  @@index([categoryId])
  @@map("teacher_category_capability")
}

/// One weekly range she is available. Several per day are allowed; overlapping
/// ones are refused in the service, where the message can name the conflict.
///
/// **Wall-clock times (TD-11), never instants** — *available Thursday 15:00–18:00*
/// is true at each branch's own clock, exactly as a class's times are.
model TeacherAvailability {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  weekday   DayOfWeek
  startTime DateTime  @map("start_time") @db.Time(0)
  endTime   DateTime  @map("end_time") @db.Time(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, weekday, startTime, endTime])
  @@index([userId, weekday])
  @@map("teacher_availability")
}
