// بذور الأمل — data model (SRS §7).
//
// BINDING (TD-6a, §20 rule 5): this file declares ONLY what Prisma can express
// — tables, columns, enums, FKs, and PLAIN unique indexes. The following are
// deliberately absent and live in hand-written SQL migrations instead, because
// Prisma either cannot express them or would silently drop them:
//   * the native `ar-x-icu` collation on structural `name` columns and on
//     sortable person-name columns
//   * every CHECK constraint (ayah bounds, 0–10,000 bp scores, display_order,
//     group time/capacity, academic-year label, Hijri offset, lowercase email)
//   * every PARTIAL unique index (`WHERE deleted_at IS NULL`, `is_current`)
//   * the cross-table ayah-bounds trigger
// Adding any of those here would fail to compile or, worse, drop the guarantee.
//
// Conventions (§16.2): UUID primary keys everywhere except the natural-key
// static lookup `QuranSurah`; snake_case columns and tables; camelCase fields.
//
// NOT PRESENT BY DESIGN (§10.1, §20 rule 16 — do not pre-create):
//   GradingTemplate / GradingTemplateItem (post-MVP weight-template engine)
//   Committee / TeacherCommittee / LevelCommittee
//   Notification / NotificationPreference
// There is no tenant dimension anywhere (Revision 11, §3.2) — never reintroduce
// tenant columns, claims, or scoping.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// TD-1 User lifecycle. The `Deleted` state of TD-1 is represented by
/// `deleted_at IS NOT NULL` rather than a fifth enum value, so a soft-deleted
/// user has exactly one source of truth instead of two that can disagree.
enum AccountStatus {
  pending
  active
  rejected
  suspended

  @@map("account_status")
}

/// Branch-level membership status, distinct from `account_status` (§7).
enum UserBranchStatus {
  active
  left
  paused

  @@map("user_branch_status")
}

enum AuthProvider {
  google

  @@map("auth_provider")
}

/// §7 Revision 27: the person-side half of `Level.gender_restriction`. Without
/// it the restriction is unenforceable — nothing could compare a person against
/// a `girls_only` Level. Nullable, so pre-Revision-27 accounts and staff need no
/// backfill; enrolment treats null as NOT eligible for a restricted Level.
enum Sex {
  female
  male

  @@map("sex")
}

enum GenderRestriction {
  any
  girls_only
  boys_only

  @@map("gender_restriction")
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday

  @@map("day_of_week")
}

/// TD-1 FamilyLink lifecycle; Approved/Rejected are terminal.
enum FamilyLinkStatus {
  pending
  approved
  rejected

  @@map("family_link_status")
}

enum ConsentType {
  media_release
  data_processing

  @@map("consent_type")
}

enum ConsentMethod {
  online_form
  staff_recorded

  @@map("consent_method")
}

/// BR-14 three-tier visibility. Never a boolean (§4.4, §4.9).
enum Visibility {
  public
  private
  hidden

  @@map("visibility")
}

/// §4.4 — ONE shared recurrence vocabulary, used by both `Event` and
/// `RecurringCourseSchedule` (Revision 43). Deliberately not modelled twice:
/// the alternating-week arithmetic is exactly the code nobody wants written in
/// two places. `none` is valid for an Event and PROHIBITED on a schedule (a
/// non-recurring occurrence is an Event) — enforced by CHECK in SQL.
enum RecurrenceType {
  none
  daily
  weekly
  multiple_weekdays
  biweekly_alternating
  monthly
  yearly

  @@map("recurrence_type")
}

/// §4.4c — which students a schedule's sessions are for. The mode lives on the
/// SCHEDULE and nowhere else (§20 rule 22): the same Level teaches one Subject
/// whole and another split, so it can be a property of neither Subject nor
/// Level. Each mode has exactly one matching target FK, enforced by CHECK.
enum TeachingMode {
  entire_level
  administrative_group
  teaching_group

  @@map("teaching_mode")
}

/// §4.4c — generalises the retired two-instructor-slot co-teaching rule rather
/// than duplicating it, and gives assistants a home without inventing a Role
/// (roles are seeded with no CRUD in the MVP, §7).
enum ScheduleStaffPosition {
  teacher
  assistant

  @@map("schedule_staff_position")
}

/// TD-1 Session lifecycle. Rescheduling and room changes are FIELD EDITS, not
/// transitions — they set the session's own date/time/room/teacher and mark it
/// `overridden`, which is what protects it from the next schedule edit (§4.4).
enum SessionStatus {
  scheduled
  cancelled
  held

  @@map("session_status")
}

enum QuranLogCategory {
  new_memorization
  revision

  @@map("quran_log_category")
}

/// R58 — the discriminator, not a flag. Each mode carries exactly the columns
/// its own reality has: a physical sitting has a room and no questions, an
/// online one has questions and no room. CHECK constraints enforce that.
enum ExamMode {
  physical
  online

  @@map("exam_mode")
}

/// R58 — one supervisor and any number of assistants, mirroring
/// `ScheduleStaffPosition` (§4.4c): one table, one rule.
enum ExamStaffPosition {
  supervisor
  assistant

  @@map("exam_staff_position")
}

enum ExamAccessPolicy {
  single_submission
  save_and_resume

  @@map("exam_access_policy")
}

/// TD-1 submission lifecycle.
enum SubmissionState {
  in_progress
  submitted
  auto_graded
  fully_graded

  @@map("submission_state")
}

/// TD-1 Grade lifecycle. Draft → Published only; the Published→Draft revert
/// belongs to the post-MVP recalculation engine (§10.1).
enum GradeStatus {
  draft
  published

  @@map("grade_status")
}

enum ConsumedTokenPurpose {
  onboarding

  @@map("consumed_token_purpose")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

/// Core identity. Minor students are User rows with NO UserIdentity records —
/// they are login-less and reached only through an approved FamilyLink
/// (§4.3, BR-5).
model User {
  examStaff     ExamStaff[]
  id            String        @id @default(uuid()) @db.Uuid
  accountStatus AccountStatus @default(pending) @map("account_status")

  // Person names. `nameArabic` is collated ar-x-icu by hand-written SQL
  // (TD-6a) so ordering is correct without per-query COLLATE (BR-19).
  /// Revision 40 — SERVER-COMPOSED from `firstNameArabic` + `lastNameArabic`.
  /// Never asked for and never composed by a client (§1.1): two clients would
  /// disagree about order and separator, and the wrong answer is a person's
  /// name rendered backwards. Remains what every consumer reads — TD-10 search,
  /// `ar-x-icu` ordering (BR-19), the display-identity fallback, the §14.2
  /// queue — and is a derived column of the same kind as the normalized shadow
  /// columns below. It is a defect for them to disagree.
  nameArabic String @map("name_arabic") @db.VarChar(120)

  /// الاسم الشخصي / الاسم العائلي (Revision 40) — the COLLECTED facts, written
  /// in the same transaction that creates the person. Nullable with no
  /// backfill: splitting an existing full name on whitespace would be a guess,
  /// and Moroccan names routinely carry compound personal names and multi-word
  /// family names. Null means "recorded before the parts were collected".
  firstNameArabic String? @map("first_name_arabic") @db.VarChar(60)
  lastNameArabic  String? @map("last_name_arabic") @db.VarChar(60)

  /// Revision 41 — server-composed from the French parts, exactly as
  /// `nameArabic` is from the Arabic ones. Retained for the same reason:
  /// consumers want the whole name, and a client must not decide its order.
  nameFrench String? @map("name_french") @db.VarChar(120)

  /// Revision 41 — the French name split like the Arabic one. ENTIRELY
  /// OPTIONAL: both parts or neither. Supplying exactly one is a validation
  /// failure, because half a name is not a name.
  firstNameFrench String? @map("first_name_french") @db.VarChar(60)
  lastNameFrench  String? @map("last_name_french") @db.VarChar(60)
  nickname        String? @db.VarChar(60)

  /// Revision 36.1 — the name shown on every PUBLIC surface when set;
  /// otherwise `nameArabic` is used. The backend resolves it and clients
  /// receive only the result: a client-side fallback would be a second source
  /// of truth for which name a person agreed to publish, and the wrong branch
  /// leaks a legal name. Distinct from `nickname`, which is an internal search
  /// convenience (TD-10).
  publicDisplayName String? @map("public_display_name") @db.VarChar(120)
  phone             String? @db.VarChar(20)
  /// Captured at registration (§4.1b step 5, Revision 27) — never patched on
  /// afterwards, because the registration exists before the User does.
  sex               Sex?    @map("sex")
  notes             String? @db.VarChar(2000)

  /// Revision 39 — THE BRANCH THE APPLICANT ASKED FOR at registration.
  ///
  /// Deliberately NOT the answer to "which branch is this person in": that
  /// answer is their Group, through `StudentGroup → Group.branchId`, because an
  /// administrator may place an approved applicant at a different branch when
  /// the requested one is full or unsuitable. Naming this `branchId` would have
  /// made two different facts share one name and created a second source of
  /// truth for placement (§16.4).
  ///
  /// Nullable with NO backfill possible — accounts predating R39 have no such
  /// value and nobody knows what those applicants would have chosen, so null
  /// means *not stated*, never *no branch*. Required in the public
  /// self-service payload (§4.1b step 5); optional for staff-assisted
  /// registration (§4.1).
  ///
  /// `Restrict`, like every other reference to a Branch (TD-5): a branch with
  /// registrations pointing at it cannot be deleted out from under them.
  intendedBranchId String? @map("intended_branch_id") @db.Uuid
  intendedBranch   Branch? @relation("UserIntendedBranch", fields: [intendedBranchId], references: [id], onDelete: Restrict)

  /// The educational stage the applicant asked for (Revision 49, proposed) —
  /// a REQUEST, exactly as `intended_branch_id` is. §4.1 step 1 preselects "the
  /// first Level of the applicant's Category" and nothing recorded one, so the
  /// clause was unimplementable. It narrows and preselects what the approver is
  /// offered; the approver may choose any Level, and the `Enrollment` is what
  /// admits the person. `Restrict`: a Category with pending requests must not
  /// vanish underneath them.
  intendedCategoryId String?   @map("intended_category_id") @db.Uuid
  intendedCategory   Category? @relation("UserIntendedCategory", fields: [intendedCategoryId], references: [id], onDelete: Restrict)

  /// The email authorized to claim this account BEFORE any external identity
  /// exists (§7, Revision 15). Staff set it when pre-provisioning; it is the
  /// only way an unbound account can be found by email, because `UserIdentity`
  /// rows exist solely for COMPLETED bindings — placeholder identity rows are
  /// prohibited. Null for self-registered accounts, which get their identity in
  /// the same transaction that creates them (§4.1b step 5).
  ///
  /// Retained, never cleared, after binding: clearing would destroy provenance
  /// and release the address for a second account to claim. Lowercase is
  /// enforced by a DB CHECK, and uniqueness among non-null values by a partial
  /// unique index — both hand-written (TD-6, TD-6a), since Prisma can express
  /// neither.
  preProvisionedEmail String? @map("pre_provisioned_email")

  /// What a self-service applicant ASKED TO BE (Revision 49, proposed) — a hint
  /// to the §5.6 approver and **never** an authority. Authority lives in
  /// `user_branch_role`, written at approval by a Super Admin; a self-declared
  /// value that granted access would be privilege escalation by form
  /// submission. Constrained in SQL to `teacher`: administrator accounts arrive
  /// through staff pre-provisioning (§4.1b step 4b), an authenticated path with
  /// a named actor. Retained after approval as provenance, like
  /// `pre_provisioned_email`.
  requestedRole String? @map("requested_role") @db.VarChar(40)

  // TD-10 normalized shadow columns, populated by the migration's
  // normalization function and indexed for substring search. Never normalized
  // per-row at query time.
  nameArabicNormalized String? @map("name_arabic_normalized")
  nameFrenchNormalized String? @map("name_french_normalized")
  nicknameNormalized   String? @map("nickname_normalized")
  phoneNormalized      String? @map("phone_normalized")

  /// TD-15 optimistic locking — staff-edited profile/role/scope changes.
  version Int @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  deletedById  String? @map("deleted_by") @db.Uuid
  deletedBy    User?   @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deletedUsers User[]  @relation("UserDeletedBy")

  identities    UserIdentity[]
  branchRoles   UserBranchRole[]
  socialProfile StudentSocialProfile?

  // Revision 43 (expand phase) — see the educational-model block below.
  levelEnrollments   Enrollment[]
  teachingGroupSeats StudentTeachingGroup[]
  staffedSchedules   CourseScheduleStaff[]
  staffedSessions    SessionStaff[]         @relation("SessionStaffUser")

  parentLinks       FamilyLink[]            @relation("FamilyLinkParent")
  childLinks        FamilyLink[]            @relation("FamilyLinkChild")
  quranLogs         QuranProgressLog[]      @relation("QuranLogStudent")
  quranLogsAuthored QuranProgressLog[]      @relation("QuranLogLoggedBy")
  surahProgress     StudentSurahProgress[]
  submissions       StudentExamSubmission[]
  grades            Grade[]
  consentsAsSubject ConsentRecord[]         @relation("ConsentStudent")
  consentsGranted   ConsentRecord[]         @relation("ConsentGrantedBy")
  consentsRevoked   ConsentRecord[]         @relation("ConsentRevokedBy")
  auditEntries      AuditLog[]
  trashEntries      Trash[]
  rateLimitCounters RateLimitCounter[]
  refreshTokens     RefreshToken[]

  @@index([accountStatus])
  @@index([deletedAt])
  // TD-10 shadow-column indexes. These MUST be declared here even though the
  // hand-written init migration already created them: Prisma diffs the live
  // database against this file, so an index it cannot see is drift it will
  // silently DROP in the next generated migration. (Caught exactly that way —
  // the TD-6b DROP lint blocked it.) Plain btree indexes are expressible in
  // Prisma, unlike the collations, CHECKs, partial indexes, and triggers that
  // §20 rule 5 keeps in SQL; the names match the migration's names so no
  // drop-and-recreate is generated.
  @@index([nameArabicNormalized])
  @@index([nameFrenchNormalized])
  @@index([nicknameNormalized])
  @@index([phoneNormalized])
  @@map("user")
}

/// Provider-abstracted auth linkage (§7). MVP: google only. Local credentials
/// join post-MVP as another provider WITHOUT restructuring User (§10.1).
/// No password column exists anywhere, ever (§20 rule 10).
model UserIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider          AuthProvider
  providerSubjectId String       @map("provider_subject_id")

  /// Always lowercased before every lookup and write (TD-12); the database
  /// independently enforces `CHECK (email = lower(email))` via TD-6a SQL.
  email String

  /// TD-5: user soft-delete deactivates identities rather than dropping them.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Plain unique — expressible in Prisma. The `(provider, email)` uniqueness
  // is scoped to ACTIVE identities and is therefore a partial index in SQL.
  @@unique([provider, providerSubjectId])
  @@index([email])
  @@map("user_identity")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  /// Seeded set (§15.1): super_admin, admin, teacher, student, parent.
  name String @unique

  branchRoles UserBranchRole[]

  @@map("role")
}

/// Role assignment scoped to a branch. Branch scoping is the sole
/// access-control axis in MVP (§4.2).
model UserBranchRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Null = unscoped (Super Admin, §2.1).
  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// The branch-level `user_status` of §7, kept separate from
  /// `User.account_status`.
  userStatus UserBranchStatus @default(active) @map("user_status")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branch_role")
}

// ---------------------------------------------------------------------------
// Structural entities — single Arabic `name`, collated ar-x-icu (§2.2, TD-6a)
// ---------------------------------------------------------------------------

model Branch {
  exams                Exam[]
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String    @db.VarChar(120)
  operationalStartDate DateTime? @map("operational_start_date") @db.Date
  /// Super-Admin-managed ordering (§2.2); CHECK (>= 0) in SQL.
  displayOrder         Int?      @map("display_order")

  /// Public contact fields (Revision 35) — the ONLY branch columns `GET
  /// /branches` may expose. Nullable at the database level so branches
  /// predating the revision need no invented address (the treatment
  /// `User.sex` received in Revision 27); *required* is enforced at the write
  /// boundary by TD-9, which is where a real value can be demanded.
  address        String? @db.VarChar(300)
  phone          String? @db.VarChar(20)
  email          String? @db.VarChar(254)
  /// Free multiline Arabic text, displayed verbatim and NEVER parsed (§7).
  /// Ramadan and exceptional weeks change the hours; free text lets the person
  /// who knows edit them without a schema conversation.
  openingHoursAr String? @map("opening_hours_ar") @db.VarChar(500)
  /// Absolute https:// URL only (TD-9) — it becomes an outbound link on a
  /// public page, where a relative or javascript: value is an injection vector.
  googleMapsUrl  String? @map("google_maps_url") @db.VarChar(500)

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  rooms Room[]

  // Revision 43 (expand phase) — see the educational-model block below.
  administrativeGroups AdministrativeGroup[]
  courseSchedules      RecurringCourseSchedule[]
  branchRoles          UserBranchRole[]
  content              EducationalContent[]
  eventScopes          EventBranch[]
  /// Revision 39 — applicants who REQUESTED this branch at registration. Not
  /// the people placed here; that is `groups → StudentGroup`.
  intendedBy           User[]                    @relation("UserIntendedBranch")

  @@index([displayOrder])
  @@map("branch")
}

model Room {
  exams    Exam[]
  id       String @id @default(uuid()) @db.Uuid
  name     String @db.VarChar(120)
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// **INFORMATIONAL ONLY — nothing compares a roster against it** (BR-23,
  /// §20 rule 22). Displayed to assist planning; no enrolment, placement or
  /// scheduling action is refused on it. The SQL CHECK constrains the value's
  /// shape (`> 0`) and nothing else.
  capacity Int?

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  // Revision 43 (expand phase) — see the educational-model block below.
  courseSchedules RecurringCourseSchedule[]
  sessions        Session[]

  @@index([branchId])
  @@map("room")
}

/// The three tracks (§4.4b): المرأة / اليافعات / الطفل.
model Category {
  id           String @id @default(uuid()) @db.Uuid
  name         String @db.VarChar(120)
  displayOrder Int?   @map("display_order")

  // NOTE: the per-Category default content visibility (§4.9) is NOT a column
  // here — §7 defines Category as carrying only `name` and `display_order`,
  // and TD-13/§15.1 place that default in `SystemSetting`. Same reasoning for
  // the per-level passing grade on Level.

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  levels      Level[]
  eventScopes EventCategory[]
  /// Revision 49 — applicants who asked for this stage. See `User`.
  intendedBy  User[]          @relation("UserIntendedCategory")

  @@index([displayOrder])
  @@map("category")
}

/// Level numbering is NOT uniform across categories — Women 0–7, Teens 1–6,
/// Children 0–6. No logic may assume every category has a level 0 (§4.4b).
model Level {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(120)
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Checked generically by progression logic — never hardcoded against a
  /// level name (§4.4b).
  genderRestriction GenderRestriction @default(any) @map("gender_restriction")

  /// Ordering is scoped within the parent Category (§2.2).
  displayOrder Int? @map("display_order")

  // NOTE: the per-level passing grade is NOT a column here — §7 defines Level
  // as carrying only `name`, `gender_restriction`, and `display_order`, and
  // TD-13/§15.1 place the passing-grade default in `SystemSetting`.

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  subjects LevelSubject[]
  surahs   LevelSurah[]

  // Revision 43 (expand phase) — see the educational-model block below.
  administrativeGroups AdministrativeGroup[]
  teachingGroups       TeachingGroup[]
  enrollments          Enrollment[]
  courseSchedules      RecurringCourseSchedule[]
  teachingGroupSeats   StudentTeachingGroup[]
  exams                Exam[]
  content              EducationalContent[]
  eventScopes          EventLevel[]

  @@index([categoryId, displayOrder])
  @@map("level")
}

/// Curriculum subject (§4.4b). Revision 43: this INCLUDES the Quran, **for
/// scheduling only** — memorization is still tracked exclusively by the §4.5
/// engine as Surah + ayah ranges (BR-13, §20 rule 23), and a Quran
/// `LevelSubject` auto-creates NO grading components (BR-9 carve-out).
model Subject {
  id           String @id @default(uuid()) @db.Uuid
  name         String @db.VarChar(120)
  displayOrder Int?   @map("display_order")

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  levels LevelSubject[]

  // Revision 43 (expand phase) — see the educational-model block below.
  teachingGroups     TeachingGroup[]
  courseSchedules    RecurringCourseSchedule[]
  teachingGroupSeats StudentTeachingGroup[]
  exams              Exam[]
  content            EducationalContent[]

  @@index([displayOrder])
  @@map("subject")
}

/// Creating a row auto-creates draft grading components (BR-9).
model LevelSubject {
  id        String  @id @default(uuid()) @db.Uuid
  levelId   String  @map("level_id") @db.Uuid
  level     Level   @relation(fields: [levelId], references: [id], onDelete: Restrict)
  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([levelId, subjectId])
  @@map("level_subject")
}

/// Creating a row for a Women's level auto-generates the two draft components
/// `[Surah] Memorization` and `[Surah] Tafsir` (§4.6, BR-9).
model LevelSurah {
  id      String     @id @default(uuid()) @db.Uuid
  levelId String     @map("level_id") @db.Uuid
  level   Level      @relation(fields: [levelId], references: [id], onDelete: Restrict)
  surahId Int        @map("surah_id")
  surah   QuranSurah @relation(fields: [surahId], references: [surahId], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([levelId, surahId])
  @@map("level_surah")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Revision 43 — educational model: ORGANISATION and DELIVERY
//
// EXPAND PHASE (TD-6b). These tables live ALONGSIDE `Group`, `GroupTeacher`,
// `StudentGroup` and `EventGroup` until the migrate phase has backfilled them
// and no released code reads the old ones. The contract migration that drops
// the old structures is a SEPARATE, LATER migration — never the same one.
// ---------------------------------------------------------------------------

/// §4.4c — the permanent ORGANISATIONAL unit inside a Level.
///
/// Carries level + branch + name and NOTHING ELSE. No room, no teacher, no
/// assistant, no schedule, **no capacity** — every one of those belongs to
/// delivery, and re-adding any of them rebuilds the exact conflation Revision
/// 43 removed (§20 rule 22).
///
/// **`branchId` stays here and is load-bearing.** It is the single answer to
/// *"which branch is this person at"* — the answer `User.intended_branch_id`
/// deliberately does NOT give, since that records only what an applicant asked
/// for (§4.1). Staff branch scoping, the §4.9 Global-content rule, and the
/// §5.2 library ordering all resolve through it.
model AdministrativeGroup {
  exams    Exam[]
  id       String @id @default(uuid()) @db.Uuid
  /// Collated `ar-x-icu` in SQL (TD-6a) — BR-19 ordering is not a per-query concern.
  name     String @db.VarChar(120)
  levelId  String @map("level_id") @db.Uuid
  level    Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// CHECK (>= 0) in SQL.
  displayOrder Int? @map("display_order")

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  enrollments Enrollment[]
  schedules   RecurringCourseSchedule[]
  grades      Grade[]
  eventScopes EventAdministrativeGroup[]

  // Redundant against the primary key ON PURPOSE: PostgreSQL requires a unique
  // constraint on the referenced column pair before `Enrollment` can declare
  // its composite FK `(administrative_group_id, level_id)`. That FK is what
  // makes `Enrollment.level_id` a CONSTRAINT rather than a copy that drifts.
  // Never remove it to "tidy up" (§20 rule 22).
  @@unique([id, levelId], map: "administrative_group_id_level_id_key")
  @@index([levelId, deletedAt])
  @@index([branchId, deletedAt])
  @@map("administrative_group")
}

/// §4.4c — a subject-specific split inside a Level.
///
/// Belongs to a Subject and a Level, **never to an AdministrativeGroup**, and
/// exists ONLY where a Subject needs students divided differently from the
/// administrative roster. A Subject with no rows here is taught to the entire
/// Level; creating these is not a prerequisite for teaching.
///
/// Splits are INDEPENDENT BETWEEN SUBJECTS — one student may sit in
/// Administrative Group 1, Quran Group 2 and Tajweed Group 1 at once. That
/// independence comes from the per-(subject, level) uniqueness on the
/// membership join below, not from anything here.
model TeachingGroup {
  id        String  @id @default(uuid()) @db.Uuid
  /// Collated `ar-x-icu` in SQL (TD-6a).
  name      String  @db.VarChar(120)
  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  levelId   String  @map("level_id") @db.Uuid
  level     Level   @relation(fields: [levelId], references: [id], onDelete: Restrict)

  displayOrder Int? @map("display_order")

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  members   StudentTeachingGroup[]
  schedules RecurringCourseSchedule[]

  // Same technique as `AdministrativeGroup(id, level_id)`: the referenced pair
  // a composite FK needs. `StudentTeachingGroup` carries subject+level and this
  // is what forces them to agree with the group's own.
  @@unique([id, subjectId, levelId], map: "teaching_group_id_subject_id_level_id_key")
  @@index([subjectId, levelId, deletedAt])
  @@map("teaching_group")
}

/// §4.4c — membership of a subject-specific split.
///
/// **At most one row per (student, subject, level)** among non-deleted rows —
/// this is what makes the splits INDEPENDENT BETWEEN SUBJECTS: the uniqueness
/// is per subject, so one student sits in Quran Group 2 and Tajweed Group 1 at
/// once without either constraining the other.
///
/// `subjectId` and `levelId` are denormalized from the teaching group for
/// exactly the reason `Enrollment.levelId` is: **a PostgreSQL unique index
/// cannot join to another table**, so the constraint is inexpressible without
/// them. The composite FK `(teaching_group_id, subject_id, level_id) →
/// TeachingGroup(id, subject_id, level_id)` makes the database refuse a row
/// whose pair disagrees with its group's, so these are CONSTRAINTS, not copies.
///
/// Membership is OPTIONAL: a student in a Level whose Subject is split but who
/// holds no row here appears on that Subject's `unassigned` list (BR-22), never
/// silently classless.
model StudentTeachingGroup {
  id              String        @id @default(uuid()) @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  student         User          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teachingGroupId String        @map("teaching_group_id") @db.Uuid
  teachingGroup   TeachingGroup @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)

  /// Kept honest by the composite FK — never written independently.
  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  levelId   String  @map("level_id") @db.Uuid
  level     Level   @relation(fields: [levelId], references: [id], onDelete: Restrict)

  addedAt     DateTime  @default(now()) @map("added_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@index([teachingGroupId, deletedAt])
  @@index([studentId, deletedAt])
  @@index([subjectId, levelId, deletedAt])
  @@map("student_teaching_group")
}

/// §4.4c — a student's membership of a Level, through one Administrative Group.
/// Replaces `StudentGroup`.
///
/// **`levelId` is denormalized DELIBERATELY and is not a second source of
/// truth.** The composite FK `(administrative_group_id, level_id) →
/// AdministrativeGroup(id, level_id)`, added in SQL, makes the database REFUSE
/// a row whose level disagrees with its group's. That is what permits a real
/// partial `UNIQUE (student_id, level_id)` — the only way to enforce "exactly
/// one Administrative Group per enrolled Level" (BR-21) without a trigger.
///
/// Level membership is stored NOWHERE ELSE. The withdrawn `StudentLevel`
/// proposal would have been the second source of truth this design avoids.
model Enrollment {
  id                    String              @id @default(uuid()) @db.Uuid
  studentId             String              @map("student_id") @db.Uuid
  student               User                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  administrativeGroupId String              @map("administrative_group_id") @db.Uuid
  administrativeGroup   AdministrativeGroup @relation(fields: [administrativeGroupId], references: [id], onDelete: Restrict)
  /// Kept honest by the composite FK above — never written independently.
  levelId               String              @map("level_id") @db.Uuid
  level                 Level               @relation(fields: [levelId], references: [id], onDelete: Restrict)

  enrolledAt  DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  // Uniqueness is scoped to non-deleted rows → partial index in SQL (TD-6).
  @@index([administrativeGroupId, deletedAt])
  @@index([levelId, deletedAt])
  @@index([studentId, deletedAt])
  @@map("enrollment")
}

/// §4.4 — the unit of DELIVERY. Materializes `Session` rows.
///
/// Exactly one target FK is non-null and matches `teachingMode`, enforced by
/// CHECK in SQL. A schedule targets ONE entity: plural targeting buys nothing a
/// second row does not, while forcing the roster query, the conflict check and
/// the consent gate each to take a set where a single value suffices (§4.4c).
model RecurringCourseSchedule {
  /// R57 — what the class is CALLED, as opposed to what identifies it.
  /// Collated `ar-x-icu` in SQL (TD-6a). A label, never an identifier: not
  /// unique, and no part of conflict detection, recurrence, materialization,
  /// the R50 split or audience resolution.
  title       String  @db.VarChar(120)
  description String? @db.VarChar(2000)

  id        String  @id @default(uuid()) @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  teachingMode TeachingMode @map("teaching_mode")

  /// Exactly ONE of the three is non-null, matching `teachingMode` (CHECK).
  levelId               String?              @map("level_id") @db.Uuid
  level                 Level?               @relation(fields: [levelId], references: [id], onDelete: Restrict)
  administrativeGroupId String?              @map("administrative_group_id") @db.Uuid
  administrativeGroup   AdministrativeGroup? @relation(fields: [administrativeGroupId], references: [id], onDelete: Restrict)
  teachingGroupId       String?              @map("teaching_group_id") @db.Uuid
  teachingGroup         TeachingGroup?       @relation(fields: [teachingGroupId], references: [id], onDelete: Restrict)

  branchId String  @map("branch_id") @db.Uuid
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomId   String? @map("room_id") @db.Uuid
  room     Room?   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  /// Local Moroccan wall-clock, never UTC instants — Ramadan DST suspension
  /// would silently shift every class by an hour, twice a year (TD-11,
  /// §20 rule 14).
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  /// Shared vocabulary (§4.4). `none` is PROHIBITED here (CHECK) — a
  /// non-recurring occurrence is an Event.
  recurrence RecurrenceType

  /// Used by weekly / multiple_weekdays / biweekly_alternating. One element for
  /// `weekly`, several for `multiple_weekdays`.
  weekdays    DayOfWeek[] @map("weekdays")
  /// Used by monthly / yearly.
  dayOfMonth  Int?        @map("day_of_month")
  monthOfYear Int?        @map("month_of_year")
  /// The week `biweekly_alternating` counts from — without an anchor, "week on"
  /// is undefined and the two halves of the alternation are indistinguishable.
  anchorDate  DateTime?   @map("anchor_date") @db.Date

  /// The last date this recurrence produces occurrences for (SRS Revision 50).
  /// **NULL is open-ended**, which every schedule created before R50 is. Set
  /// when a schedule is SPLIT for a "this and all future" edit: the current
  /// schedule is closed here and a successor is anchored at the split date.
  /// With `anchor_date` it bounds one series. A calendar date, not an instant
  /// (TD-11) — a schedule ends after a day's classes.
  effectiveUntil DateTime? @map("effective_until") @db.Date

  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  staff    CourseScheduleStaff[]
  sessions Session[]

  @@index([branchId, deletedAt])
  @@index([subjectId, deletedAt])
  @@index([academicYearId, deletedAt])
  @@map("recurring_course_schedule")
}

/// §4.4c — **the resolution table for ALL teacher scoping.** Replaces
/// `GroupTeacher`.
///
/// A teacher's reach is the union of the resolved audiences of the schedules
/// they staff, and `schedule.branch_id` states their branch scope DIRECTLY,
/// where the retired path inferred it through two hops. The rule itself lives
/// in §4.4c and in `policies/` — this model only holds the rows.
model CourseScheduleStaff {
  id         String                  @id @default(uuid()) @db.Uuid
  scheduleId String                  @map("schedule_id") @db.Uuid
  schedule   RecurringCourseSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  userId     String                  @map("user_id") @db.Uuid
  user       User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  position ScheduleStaffPosition

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([scheduleId, userId])
  @@index([userId, deletedAt])
  @@map("course_schedule_staff")
}

/// §4.4 — ONE materialized dated occurrence of a schedule.
///
/// Carries its OWN date, time, room and teacher, defaulted from the schedule
/// and individually overridable. That is what makes a cancellation, a room
/// change, a reschedule and a makeup class EDITS TO THIS ROW rather than a
/// parallel Event mechanism.
///
/// **The audience is NOT stored here** (§20 rule 22). It resolves from the
/// schedule's mode and target at read time; a snapshot would silently diverge
/// from the group it came from, which is the failure Revision 43 exists to
/// remove.
model Session {
  id         String                  @id @default(uuid()) @db.Uuid
  scheduleId String                  @map("schedule_id") @db.Uuid
  schedule   RecurringCourseSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  /// A calendar date, never an instant (TD-11).
  date      DateTime @db.Date
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  /// Snapshot at materialization (Revision 43.4), not re-derived from the
  /// schedule: a held session must stay historically correct.
  roomId String? @map("room_id") @db.Uuid
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  status SessionStatus @default(scheduled)

  /// Distinguishes a human's deliberate change from a `session.materialize`
  /// default. This flag is what protects the row from the next schedule edit
  /// (§20 rule 24) — an overridden session is never rewritten or deleted.
  overridden Boolean @default(false)

  /// Mandatory on cancel (TD-8 `session.cancel`).
  cancellationReason String? @map("cancellation_reason") @db.VarChar(500)

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  linkedContent SessionContent[]
  staff         SessionStaff[]

  // What makes `session.materialize` idempotent: a second run over the same
  // horizon creates no duplicate occurrence.
  @@unique([scheduleId, date])
  // What makes room conflict detection a lookup rather than a scan. The staff
  // side is indexed on `SessionStaff` below.
  @@index([roomId, date])
  @@index([date, status])
  @@map("session")
}

/// §7 (Revision 43.4) — **the teaching assignment as it stood for ONE
/// occurrence.**
///
/// Mirrors `CourseScheduleStaff` exactly, and replaces the single
/// `Session.teacher_id`: the association co-teaches and classes have
/// assistants, so one column could not hold the answer, and keeping both a
/// column and a join would give *"who taught this"* two homes that drift.
///
/// **This is a snapshot, and that is the whole point.** Editing a schedule's
/// staff in June must not re-attribute March's classes to someone who never
/// taught them. Rows here are written by `session.materialize` for FUTURE
/// occurrences and by a deliberate override; a past or `held` session's rows are
/// never rewritten by a schedule edit (§4.4).
///
/// **Not in tension with §20 rule 22.** That rule bans snapshotting a session's
/// *audience*, because enrolment changes must be reflected live. Staffing is the
/// opposite kind of fact: what was arranged for this occurrence.
model SessionStaff {
  id        String  @id @default(uuid()) @db.Uuid
  sessionId String  @map("session_id") @db.Uuid
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  userId    String  @map("user_id") @db.Uuid
  user      User    @relation("SessionStaffUser", fields: [userId], references: [id], onDelete: Restrict)

  position ScheduleStaffPosition

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([sessionId, userId])
  // The teacher/assistant half of conflict detection: "is this person already
  // committed on this date" must be a lookup.
  @@index([userId, deletedAt])
  @@map("session_staff")
}

/// §4.9 — a Session REFERENCES content; it never owns it.
///
/// One semester PDF is referenced by every session that uses it, and unlinking
/// a session never deletes the file. Replaces the retired single
/// `EducationalContent.event_id`, which could express only one relationship, in
/// one direction, to the wrong entity.
model SessionContent {
  id        String             @id @default(uuid()) @db.Uuid
  sessionId String             @map("session_id") @db.Uuid
  session   Session            @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  contentId String             @map("educational_content_id") @db.Uuid
  content   EducationalContent @relation(fields: [contentId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([sessionId, contentId])
  @@index([contentId, deletedAt])
  @@map("session_content")
}

/// Event scope join over organisational groups (Revision 43 — replaces
/// `EventGroup`). Events scope to Administrative Groups, never to Teaching
/// Groups: an event is not subject-specific.
model EventAdministrativeGroup {
  id                    String              @id @default(uuid()) @db.Uuid
  eventId               String              @map("event_id") @db.Uuid
  event                 Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  administrativeGroupId String              @map("administrative_group_id") @db.Uuid
  administrativeGroup   AdministrativeGroup @relation(fields: [administrativeGroupId], references: [id], onDelete: Restrict)

  @@unique([eventId, administrativeGroupId])
  @@index([administrativeGroupId])
  @@map("event_administrative_group")
}

// ---------------------------------------------------------------------------
// Family & consent (safeguarding)
// ---------------------------------------------------------------------------

/// THE authorization record checked by the `X-Active-Child-ID` middleware on
/// every child-scoped request (§4.3). Matching the child alone is never
/// sufficient — both parent and child must match an Approved row (§20 rule 6).
model FamilyLink {
  id        String           @id @default(uuid()) @db.Uuid
  parentId  String           @map("parent_id") @db.Uuid
  parent    User             @relation("FamilyLinkParent", fields: [parentId], references: [id], onDelete: Restrict)
  studentId String           @map("student_id") @db.Uuid
  student   User             @relation("FamilyLinkChild", fields: [studentId], references: [id], onDelete: Restrict)
  status    FamilyLinkStatus @default(pending)

  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedById    String?   @map("decided_by") @db.Uuid
  decisionReason String?   @map("decision_reason") @db.VarChar(500)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  // Uniqueness is scoped to non-deleted rows → partial index in SQL (TD-6).
  @@index([parentId, status])
  @@index([studentId, status])
  @@map("family_link")
}

/// One row per consent decision. Consent is NEVER a boolean on the user row
/// (§20 rule 2); absence of a record means NO consent (BR-1). History is
/// preserved — revocation is a state change with its own actor and timestamp.
model ConsentRecord {
  id          String        @id @default(uuid()) @db.Uuid
  studentId   String        @map("student_id") @db.Uuid
  student     User          @relation("ConsentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  consentType ConsentType   @map("consent_type")
  granted     Boolean
  method      ConsentMethod

  /// The exact legal text version agreed to (§2.3, §4.1a).
  consentTextVersion String @map("consent_text_version") @db.VarChar(60)

  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByUserId String    @map("granted_by_user_id") @db.Uuid
  grantedBy       User      @relation("ConsentGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokedBy       User?     @relation("ConsentRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([studentId, consentType, grantedAt])
  @@map("consent_record")
}

/// Replay guard for single-use onboarding tokens. The `jti` insert happens
/// INSIDE the registration transaction (§4.1b step 5, TD-4.1): a replayed
/// token hits this unique constraint, the transaction aborts, and the request
/// fails with 409 STATE_CONFLICT.
model ConsumedToken {
  id         String               @id @default(uuid()) @db.Uuid
  jti        String               @unique
  purpose    ConsumedTokenPurpose
  consumedAt DateTime             @default(now()) @map("consumed_at") @db.Timestamptz(6)
  /// Rows past this horizon are removed by the daily `token.purge` job (TD-7).
  expiresAt  DateTime             @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("consumed_token")
}

/// Why a session is dead (§7, Revision 16). `reuse_detected` is a security
/// event — a rotated token was replayed outside the grace window.
enum RefreshRevokedReason {
  logout
  suspension
  user_deleted
  reuse_detected

  @@map("refresh_revoked_reason")
}

/// One row per ISSUED refresh token (§7, Revision 16). This is the server-side
/// state TD-12 requires: rotation on use, the revocation list, immediate
/// revocation on suspension, and the 10-second predecessor grace window.
///
/// Deliberately absent, each evaluated and rejected in §7: `created_at` (same
/// instant as `issuedAt`), `revoked_by` (duplicates `AuditLog.actorUserId`),
/// `created_by_ip` / `user_agent_hash` (personal data, no MVP consumer, no
/// retention rule), `last_used_at` (derivable from the successor's `issuedAt`
/// under mandatory rotation). Do not re-add them without an SRS revision.
model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Stable id of one rotation CHAIN, stamped on the first token and copied to
  /// every successor. Makes "revoke this session" (logout) and "revoke the
  /// whole chain" (reuse detected) single indexed UPDATEs — walking
  /// `rotatedFromId` would need a recursive CTE, and §16.2 permits raw SQL
  /// only for row locks and pg-boss inserts.
  sessionId String @map("session_id") @db.Uuid

  /// Hashed, NEVER raw (TD-12): a stolen database dump must not yield usable
  /// 30-day credentials. Unique (TD-6).
  tokenHash String @unique @map("token_hash")

  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// 30-day TTL (TD-12) and the `token.purge` horizon (TD-7).
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// The immediate predecessor. This one field decides all three refresh
  /// outcomes: current → rotate; immediate predecessor inside 10 s → accept
  /// without re-rotating; anything older → reuse detected (TD-12).
  rotatedFromId String?       @unique @map("rotated_from_id") @db.Uuid
  rotatedFrom   RefreshToken? @relation("RefreshRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo     RefreshToken? @relation("RefreshRotation")

  /// The revocation-list check is `revokedAt IS NULL`.
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason RefreshRevokedReason? @map("revoked_reason")

  @@index([userId, revokedAt])
  @@index([sessionId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_token")
}

/// Authoritative store for per-user quotas that Nginx cannot enforce (§3.1,
/// §7, Revision 14). `limit_req` keys on connection variables and cannot read
/// a JWT subject, and its grammar admits only r/s and r/m, so an hourly
/// per-user quota has no representation at the edge.
///
/// The counter is locked and incremented INSIDE the transaction of the action
/// it gates (TD-4.12, TD-15.2) — evaluating the count outside would let two
/// concurrent initiations both pass at the limit boundary. Never held in
/// process memory (dies with the container, wrong across replicas) and never
/// routed through pg-boss (a job queue is asynchronous; this decision must be
/// synchronous). Elapsed windows are removed by `ratelimit.purge` (TD-7).
model RateLimitCounter {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Names the quota. MVP: `upload.initiate` (30/hour, TD-13).
  bucket String @db.VarChar(60)

  /// Truncated start of the fixed window.
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// The unique key is what makes the increment safe under concurrency (TD-6).
  @@unique([userId, bucket, windowStart])
  @@index([windowStart])
  @@map("rate_limit_counter")
}

/// Restricted case-file data (BR-16, §4.10). Field-level access: Admins and
/// the student's specifically-assigned teachers only — never other students,
/// unrelated guardians, or teachers at large.
model StudentSocialProfile {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @unique @map("student_id") @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  healthCondition  String? @map("health_condition") @db.VarChar(2000)
  familySituation  String? @map("family_situation") @db.VarChar(2000)
  homeAddress      String? @map("home_address") @db.VarChar(2000)
  siblingsCount    Int?    @map("siblings_count")
  fatherName       String? @map("father_name") @db.VarChar(120)
  fatherProfession String? @map("father_profession") @db.VarChar(120)
  motherName       String? @map("mother_name") @db.VarChar(120)
  motherProfession String? @map("mother_profession") @db.VarChar(120)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@map("student_social_profile")
}

// ---------------------------------------------------------------------------
// Calendar — the exception layer over Groups' fixed weekly schedules (§4.4)
// ---------------------------------------------------------------------------

model Event {
  id          String     @id @default(uuid()) @db.Uuid
  title       String     @db.VarChar(120)
  description String?    @db.VarChar(2000)
  visibility  Visibility @default(private)

  /// Local wall-clock date/time fields (TD-11) — never UTC instants.
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  startTime DateTime? @map("start_time") @db.Time(0)
  endTime   DateTime? @map("end_time") @db.Time(0)

  recurrenceType    RecurrenceType @default(none) @map("recurrence_type")
  recurrenceEndDate DateTime?      @map("recurrence_end_date") @db.Date

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  branchScopes   EventBranch[]
  categoryScopes EventCategory[]
  levelScopes    EventLevel[]

  // Revision 43 (expand phase) — see the educational-model block below.
  administrativeGroupScopes EventAdministrativeGroup[]

  @@index([startDate, visibility])
  @@map("event")
}

// The four scope joins are populated EXPLICITLY at event creation — never
// evaluated as runtime null/wildcard matches (§4.4).

model EventBranch {
  eventId  String @map("event_id") @db.Uuid
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([eventId, branchId])
  @@map("event_branch")
}

model EventCategory {
  eventId    String   @map("event_id") @db.Uuid
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([eventId, categoryId])
  @@map("event_category")
}

model EventLevel {
  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  levelId String @map("level_id") @db.Uuid
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)

  @@id([eventId, levelId])
  @@map("event_level")
}

// ---------------------------------------------------------------------------
// Quran memorization (§4.5)
// ---------------------------------------------------------------------------

/// Static pre-seeded lookup, all 114 rows (§15.1). The ONLY entity with a
/// natural key rather than a UUID (§16.2). `totalAyahs` is the definitive
/// denominator for coverage.
model QuranSurah {
  surahId            Int    @id @map("surah_id")
  nameArabic         String @map("name_arabic") @db.VarChar(120)
  nameTransliterated String @map("name_transliterated") @db.VarChar(120)
  totalAyahs         Int    @map("total_ayahs")

  logs     QuranProgressLog[]
  progress StudentSurahProgress[]
  levels   LevelSurah[]
  exams    Exam[]

  @@map("quran_surah")
}

/// Discrete closed ayah ranges. Any create/update/soft-delete triggers
/// SYNCHRONOUS per-surah recalculation in the same request — never a
/// background job (§4.5, BR-13, §20 rule 1).
model QuranProgressLog {
  id        String     @id @default(uuid()) @db.Uuid
  studentId String     @map("student_id") @db.Uuid
  student   User       @relation("QuranLogStudent", fields: [studentId], references: [id], onDelete: Restrict)
  surahId   Int        @map("surah_id")
  surah     QuranSurah @relation(fields: [surahId], references: [surahId], onDelete: Restrict)

  /// CHECK (start_ayah >= 1 AND start_ayah <= end_ayah) in SQL; the upper
  /// bound against `total_ayahs` crosses tables and is enforced by a trigger
  /// plus the service layer (TD-6).
  startAyah Int              @map("start_ayah")
  endAyah   Int              @map("end_ayah")
  category  QuranLogCategory

  loggedById String   @map("logged_by") @db.Uuid
  loggedBy   User     @relation("QuranLogLoggedBy", fields: [loggedById], references: [id], onDelete: Restrict)
  loggedAt   DateTime @default(now()) @map("logged_at") @db.Timestamptz(6)

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  // TD-6 names this composite explicitly as a hot path.
  @@index([studentId, surahId])
  @@index([studentId, surahId, deletedAt])
  @@map("quran_progress_log")
}

/// Self-healing coverage cache (§4.5). NEVER the source of truth — the logs
/// are. Every reader compares the stamp against the student+surah's latest log
/// and repairs the row in place on mismatch, which makes stale reads
/// structurally impossible (BR-13).
model StudentSurahProgress {
  id        String     @id @default(uuid()) @db.Uuid
  studentId String     @map("student_id") @db.Uuid
  student   User       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  surahId   Int        @map("surah_id")
  surah     QuranSurah @relation(fields: [surahId], references: [surahId], onDelete: Restrict)

  /// Union of merged, non-overlapping intervals. `mergedAyahCount` is the
  /// exact numerator; `coveragePercent` is Decimal (never float) so a 100.00
  /// comparison for level completion is exact (BR-11, BR-13).
  mergedAyahCount Int     @map("merged_ayah_count")
  coveragePercent Decimal @map("coverage_percent") @db.Decimal(5, 2)
  mergedIntervals Json    @map("merged_intervals") @db.JsonB

  /// Freshness stamp of the newest governing log (§4.5 read-side guard).
  lastLogId String?   @map("last_log_id") @db.Uuid
  lastLogAt DateTime? @map("last_log_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([studentId, surahId])
  @@map("student_surah_progress")
}

// ---------------------------------------------------------------------------
// Exams & grading (§4.6)
// ---------------------------------------------------------------------------

/// Exams are independent of calendar bounds. Every question in `questions`
/// carries an immutable auto-generated UUID; submissions reference those UUIDs
/// and never array positions (TD-6).
model Exam {
  id        String      @id @default(uuid()) @db.Uuid
  title     String      @db.VarChar(120)
  levelId   String      @map("level_id") @db.Uuid
  level     Level       @relation(fields: [levelId], references: [id], onDelete: Restrict)
  subjectId String?     @map("subject_id") @db.Uuid
  subject   Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  surahId   Int?        @map("surah_id")
  surah     QuranSurah? @relation(fields: [surahId], references: [surahId], onDelete: Restrict)

  /// R58 — the discriminator, not a flag. `physical` is organised in the
  /// platform; `online` is declared and refused until it is planned as its own
  /// feature. Fixed after creation: changing it would discard every column the
  /// other mode does not have.
  mode ExamMode @default(physical)

  description String? @db.VarChar(2000)

  /// R58 — a gap independent of the mode: content and course schedules both
  /// carry a year, and grades aggregate per year, yet an exam did not.
  academicYearId String?       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  date DateTime @db.Date

  /// R58, physical only — where it is sat and when. Wall-clock times (TD-11),
  /// never instants: an exam at 09:00 is at 09:00 at its branch.
  branchId  String?   @map("branch_id") @db.Uuid
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomId    String?   @map("room_id") @db.Uuid
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  startTime DateTime? @map("start_time") @db.Time(0)
  endTime   DateTime? @map("end_time") @db.Time(0)

  /// R58 — **NULL is the whole Level**, not "no target". A narrower audience
  /// when one group sits separately. The §4.4c three-mode target is deliberately
  /// not reused: an exam is sat by a roster at a premises, and the Teaching
  /// Group split has no bearing on who sits a paper.
  administrativeGroupId String?              @map("administrative_group_id") @db.Uuid
  administrativeGroup   AdministrativeGroup? @relation(fields: [administrativeGroupId], references: [id], onDelete: Restrict)

  staff ExamStaff[]

  round Int?

  accessPolicy ExamAccessPolicy @default(save_and_resume) @map("access_policy")

  questions Json @db.JsonB

  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  submissions StudentExamSubmission[]
  grades      Grade[]
}


model StudentExamSubmission {
  id        String @id @default(uuid()) @db.Uuid
  examId    String @map("exam_id") @db.Uuid
  exam      Exam   @relation(fields: [examId], references: [id], onDelete: Restrict)
  studentId String @map("student_id") @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  /// Answers keyed by question UUID — never by array position (TD-6).
  answers Json @db.JsonB

  state SubmissionState @default(in_progress)

  /// Integer basis points, 0–10,000; CHECK enforced in SQL. No float score
  /// column exists anywhere (§4.6, §20 rule 3).
  autoScoreBp Int? @map("auto_score_bp")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("student_exam_submission")
}

/// Per student, per exam. MVP grades are per-exam and informational — there
/// are no averages and no template references (§4.6, Revision 12).
model Grade {
  id        String @id @default(uuid()) @db.Uuid
  examId    String @map("exam_id") @db.Uuid
  exam      Exam   @relation(fields: [examId], references: [id], onDelete: Restrict)
  studentId String @map("student_id") @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  /// Sitting provenance (Revision 43). The **Administrative Group** — the stable
  /// organisational unit that exists for every student in every enrolled Level.
  /// A Teaching Group exists only for split Subjects and would leave most
  /// sittings without provenance.
  administrativeGroupId String?              @map("administrative_group_id") @db.Uuid
  administrativeGroup   AdministrativeGroup? @relation(fields: [administrativeGroupId], references: [id], onDelete: Restrict)

  /// Integer basis points of the exam total, 0–10,000 (CHECK in SQL).
  valueBp Int         @map("value_bp")
  status  GradeStatus @default(draft)

  /// BR-7: an enrolled student with no submission gets 0 flagged absent, and
  /// the row is initialized at the teacher's FIRST draft save so draft
  /// averages are never inflated by omission (§4.6).
  absent Boolean @default(false)

  /// BR-12: a manual override always wins over computed results.
  manualPassFailOverride Boolean?  @map("manual_pass_fail_override")
  overrideById           String?   @map("override_by") @db.Uuid
  overrideAt             DateTime? @map("override_at") @db.Timestamptz(6)
  overrideReason         String?   @map("override_reason") @db.VarChar(500)

  /// TD-15: concurrent co-teacher scoring vs admin override must not clobber.
  version Int @default(0)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([examId, studentId])
  @@index([studentId, status])
  @@map("grade")
}

// ---------------------------------------------------------------------------
// Content & storage (§4.9)
// ---------------------------------------------------------------------------

model AcademicYear {
  exams     Exam[]
  id        String  @id @default(uuid()) @db.Uuid
  /// Validated `YYYY-YYYY`; free-text year strings are prohibited (§4.10).
  label     String  @unique @db.VarChar(9)
  /// Exactly one `true` row application-wide — partial unique index in SQL.
  isCurrent Boolean @default(false) @map("is_current")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  content EducationalContent[]

  // Revision 43 (expand phase) — see the educational-model block below.
  courseSchedules RecurringCourseSchedule[]

  @@map("academic_year")
}

model EducationalContent {
  id          String  @id @default(uuid()) @db.Uuid
  title       String  @db.VarChar(120)
  description String? @db.VarChar(2000)

  visibility Visibility @default(private)

  /// Maintained by the consent re-evaluation engine (§4.1a). Lifting it is
  /// Admin-only with a mandatory justification — Teachers never can
  /// (BR-3, §20 rule 7).
  consentForcedPrivate Boolean @default(false) @map("consent_forced_private")

  levelId String @map("level_id") @db.Uuid
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)

  /// NULL = the Global / بدون فرع scope. Assignable only by Admins and Super
  /// Admins; Teachers are locked to their own branch scope (BR-20, §4.9).
  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// Required (Revision 43): content belongs to a Subject as well as a Level.
  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  /// Immutable hash-segmented key (TD-9). Replacing a file mints a NEW key and
  /// quarantines the old object — keys are never reused or overwritten
  /// (§20 rule 15). Visibility is never encoded in the key; the bucket carries
  /// it.
  storageBucket    String @map("storage_bucket") @db.VarChar(20)
  storageKey       String @unique @map("storage_key")
  originalFilename String @map("original_filename")
  mimeType         String @map("mime_type") @db.VarChar(120)
  sizeBytes        BigInt @map("size_bytes")

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  sessionLinks SessionContent[]

  @@index([levelId, academicYearId, branchId])
  @@index([visibility])
  @@map("educational_content")
}

// ---------------------------------------------------------------------------
// Platform: audit, trash, settings
// ---------------------------------------------------------------------------

/// Append-only accountability record (TD-8). No update or delete path exists
/// in the application. Distinct from `Trash`, which exists for restoration.
/// R58 — who supervises a physical sitting. The shape `CourseScheduleStaff`
/// already uses (§4.4c): one row per person, a position, soft-deletable.
model ExamStaff {
  id     String @id @default(uuid()) @db.Uuid
  examId String @map("exam_id") @db.Uuid
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  position ExamStaffPosition

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  /// One person holds one position on one exam.
  @@unique([examId, userId])
  @@index([userId])
  @@map("exam_staff")
}

model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  actionType   String  @map("action_type") @db.VarChar(60)
  targetEntity String? @map("target_entity") @db.VarChar(60)
  targetId     String? @map("target_id") @db.Uuid

  /// Includes mandatory justifications (consent-gate overrides, pass/fail
  /// overrides). Never PII beyond what TD-8 requires (TD-14).
  detail Json @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actionType, createdAt])
  @@index([targetEntity, targetId])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

/// JSON snapshot of any soft-deleted record, for restoration (§4.10, BR-15).
/// MVP restoration runs through the locked CLI script, never ad-hoc psql.
/// The 90-day window is enforced by `content.quarantine-purge` (TD-7).
model Trash {
  id           String @id @default(uuid()) @db.Uuid
  targetEntity String @map("target_entity") @db.VarChar(60)
  targetId     String @map("target_id") @db.Uuid

  /// Full row snapshot INCLUDING the cascaded relationship rows (FamilyLink,
  /// GroupTeacher, UserBranchRole, UserIdentity deactivations) — a User
  /// restored without them is a half-restored, silently broken account (§4.10).
  snapshot Json @db.JsonB

  deletedById String?  @map("deleted_by") @db.Uuid
  deletedBy   User?    @relation(fields: [deletedById], references: [id], onDelete: Restrict)
  deletedAt   DateTime @default(now()) @map("deleted_at") @db.Timestamptz(6)
  /// End of the 90-day permanent-delete window (BR-15).
  purgeAfter  DateTime @map("purge_after") @db.Timestamptz(6)

  @@index([targetEntity, targetId])
  @@index([purgeAfter])
  @@map("trash")
}

/// Application-level runtime config (TD-13): branding, legal/consent text
/// versions, Hijri day offset (−2…+2, CHECK in SQL), category default
/// visibilities, per-level passing defaults.
/// The official Moroccan Hijri calendar (SRS Revision 31, §4.4, §7).
///
/// One row per Hijri month, recording the Gregorian date on which that month
/// officially began according to the Ministry of Habous and Islamic Affairs.
/// This table is the SOLE source of every Hijri value the platform displays —
/// no caller computes one astronomically, and there is no day-offset.
///
/// Rows arrive either by manual entry or, later, by an automated import; both
/// write here, so the two paths cannot diverge.
model HijriMonthStart {
  id String @id @default(uuid()) @db.Uuid

  hijriYear  Int @map("hijri_year")
  /// 1–12.
  hijriMonth Int @map("hijri_month")

  /// Local calendar date (TD-11) — a `date`, never an instant.
  gregorianStartDate DateTime @map("gregorian_start_date") @db.Date

  /// Only `published` months are rendered anywhere, so a year can be entered
  /// progressively and reviewed before it becomes visible.
  status HijriMonthStatus @default(draft)

  /// The provenance of the row: `manual`, or an importer's source identifier.
  source String @default("manual") @db.VarChar(80)

  version Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid

  @@unique([hijriYear, hijriMonth])
  /// Resolution walks backwards from a Gregorian date to the month containing
  /// it, so this is the index that read path uses.
  @@index([gregorianStartDate])
  @@map("hijri_month_start")
}

enum HijriMonthStatus {
  draft
  published

  @@map("hijri_month_status")
}

model SystemSetting {
  key   String @id @db.VarChar(80)
  value Json   @db.JsonB

  version Int @default(0)

  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?  @map("updated_by") @db.Uuid

  @@map("system_setting")
}
