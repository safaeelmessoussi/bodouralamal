# ==============================================================================
# بذور الأمل — environment configuration template
# Generated from the SRS TD-13 machine-readable inventory (the single
# authoritative list); this file must stay in lockstep with that table.
#
# Usage: cp .env.example .env  →  fill values. Never commit .env (§20 rule 18).
# Secrets have NO defaults by design (TD-13); values below are intentionally
# empty. The API fails fast at boot with a named error if any Required
# variable is missing (backend/src/lib/config.ts).
# ==============================================================================

# ------------------------------- Required ------------------------------------

# PostgreSQL connection for Prisma + pg-boss (TD-13).
# Example: postgres://app:<password>@db:5432/bodour
DATABASE_URL=

# Google OAuth client (§4.1b). Example ID: 1234….apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Access-token signing key (TD-12); rotatable. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=

# Onboarding-token signing key (§4.1b) — MUST be distinct from JWT_SIGNING_KEY.
# Generate: openssl rand -base64 48
ONBOARDING_TOKEN_KEY=
# Ratified email-lock design: dedicated required key; never reuse JWT/onboarding.
# Generate privately: openssl rand -base64 48. See docs/development/email-lock-keying.md.
EMAIL_LOCK_KEY=

# Internal S3 API endpoint (§3.1). Example: http://minio:9000
MINIO_ENDPOINT=

# MinIO credentials. Example access key: bodour-app.
# Generate secret: openssl rand -base64 32
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Canonical origin — client at /, API at /api/v1/ (§3.1 same-origin routing).
# Example: https://platform.bodour.ma
PUBLIC_BASE_URL=

# Public storage path prefix (§3.1); presigned URLs are signed against this
# origin so signatures survive the Nginx /storage proxy.
# Example: https://platform.bodour.ma/storage
STORAGE_BASE_URL=

# BOOTSTRAP ONLY (§15.1, Revision 115). Read by `npm run seed:production`, never
# by the running API, and only while the Platform Owner singleton does not yet
# exist. It must name this Owner-approved initial identity. Once ownership
# exists the value is ignored permanently; seed reruns never reclaim a valid
# transfer or create an automatic successor. Identity binds on first Google
# login (§4.1b), without a placeholder provider subject.
SUPER_ADMIN_EMAIL=safae.elmessoussi@gmail.com

# The approved initial Platform Owner is female (Revisions 80 and 115). This is
# seed-only on the same singleton gate above; it is required as `female` before
# bootstrap and ignored after ownership exists. The value is explicit rather
# than inferred from a name, role or title.
SUPER_ADMIN_SEX=female

# production | development | test — gates exactly three behaviours: fixtures
# refuse in production (§15.2), BACKUP_TARGET_SSH is Production-only, and
# LOG_LEVEL=debug is forbidden in Production. It never changes error detail or
# any security control (Revision 104). Real beneficiary data exists only in
# Production (BR-18, R-10).
NODE_ENV=development

# ------------------------- Required in production only ------------------------

# Legacy required compatibility setting (§6); temporary B8 same-VPS mode may use
# /var/lib/bodour-backups/bodour. Host scheduling/key config: docs/operations/recovery.md.
BACKUP_TARGET_SSH=

# ------------------------- Optional (defaults shown) ---------------------------

# Container wall-clock alignment (TD-11).
TZ=Africa/Casablanca

# API listen port behind Nginx (§3.1).
PORT=3000

# Structured log verbosity (TD-14): info | debug. debug is prohibited in
# production (TD-13).
LOG_LEVEL=info

# ------------- Online classes: the self-hosted media server (R98, R164) --------

# Classes delivered عن بُعد run on THIS deployment's own media server — LiveKit,
# its Egress recorder and Redis, defined once in docker-compose.yml and identical
# on Localhost, Staging and Production (SRS Revision 164). Beneficiaries' audio,
# video and recordings never leave this infrastructure: no LiveKit Cloud, no
# third-party STUN/TURN, and recordings are written straight into the object
# store above.
#
# ALL THREE OR NONE for the application (LIVEKIT_URL, _API_KEY, _API_SECRET):
# setting only some is refused at boot — a URL with no secret boots, looks
# configured, and then fails in front of a class. Release tiers set all of them;
# host preflight refuses a Staging or Production host that has not.
#
# The secret NEVER reaches the browser: participant tokens are minted in the API
# from the platform's own authorization (R98.5) and carry only what they name.
#
# What the BROWSER connects to. Signalling is same-origin — Nginx proxies `/rtc`
# to the media server — so this is simply the deployment's own origin:
#   Release tiers:  LIVEKIT_URL=wss://<domain>
#   Localhost:      LIVEKIT_URL=ws://localhost
LIVEKIT_URL=
# What the API calls the media server on: the internal network, on every tier.
#   LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_URL=
# One key pair, shared by the API, the media server and the recorder — all three
# read these two values. The secret is dedicated and at least 32 bytes:
#   openssl rand -hex 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The address browsers are told to send MEDIA to. Release tiers: this host's
# public IPv4 (host preflight holds it to the approved one). It is stated rather
# than discovered, because discovery means asking a public STUN server.
# Localhost: leave empty — the container's own address is advertised and this
# machine reaches it directly.
LIVEKIT_NODE_IP=

# R99 — where the online-class recording facility leaves its output.
#
# A bucket the platform OWNS but does NOT serve: neither `public` nor `private`.
# The provider writes here, the platform then verifies the object and only then
# does it enter the content lifecycle — which is what keeps a temporary provider
# artefact from ever being what the library points at.
RECORDING_STAGING_BUCKET=recordings-staging

# **Email-lock keying** — the HMAC key for `normalized_email_lock`'s primary key.
#
# `HMAC-SHA-256(EMAIL_LOCK_KEY, "bodour.email-lock.v1|" + normalized)`. HMAC
# rather than a bare digest because the space of real addresses is small and
# enumerable, so an unkeyed hash is the address in a thin disguise.
#
# **A distinct secret, never a reused one.** Borrowing `JWT_SIGNING_KEY` would
# couple routine session-key rotation to the integrity of every email lock.
#
# **Empty here, like every other secret** (TD-13: secrets have no defaults). Each
# environment supplies its own out of band; a usable value in this file would be
# a committed secret whatever the file is called.
# Generate: openssl rand -base64 48
#
# NOT YET READ BY THE APPLICATION. The design is ratified and the migration is
# deliberately unwritten — see docs/development/email-lock-keying.md. Declared
# here so the variable is documented where every other one is.
EMAIL_LOCK_KEY=
