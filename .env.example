MINIO_ACCESS_KEY="bodour-app"
MINIO_SECRET_KEY="development_storage_password"

# Base URL Mappings
PUBLIC_BASE_URL="http://localhost"
STORAGE_BASE_URL="http://localhost/storage"

# Deployment & Seeding Controls
SUPER_ADMIN_EMAIL="admin@bodour.ma"
NODE_ENV="development"
LOG_LEVEL="debug"
PORT=3000