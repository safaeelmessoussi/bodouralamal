# ==============================================================================
# بذور الأمل — environment configuration template
# Generated from the SRS TD-13 machine-readable inventory (the single
# authoritative list); this file must stay in lockstep with that table.
#
# Usage: cp .env.example .env  →  fill values. Never commit .env (§20 rule 18).
# Secrets have NO defaults by design (TD-13); values below are intentionally
# empty. The API fails fast at boot with a named error if any Required
# variable is missing (backend/src/lib/config.ts).
# ==============================================================================

# ------------------------------- Required ------------------------------------

# PostgreSQL connection for Prisma + pg-boss (TD-13).
# Example: postgres://app:<password>@db:5432/bodour
DATABASE_URL=

# Google OAuth client (§4.1b). Example ID: 1234….apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Access-token signing key (TD-12); rotatable. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=

# Onboarding-token signing key (§4.1b) — MUST be distinct from JWT_SIGNING_KEY.
# Generate: openssl rand -base64 48
ONBOARDING_TOKEN_KEY=

# Internal S3 API endpoint (§3.1). Example: http://minio:9000
MINIO_ENDPOINT=

# MinIO credentials. Example access key: bodour-app.
# Generate secret: openssl rand -base64 32
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Canonical origin — client at /, API at /api/v1/ (§3.1 same-origin routing).
# Example: https://platform.bodour.ma
PUBLIC_BASE_URL=

# Public storage path prefix (§3.1); presigned URLs are signed against this
# origin so signatures survive the Nginx /storage proxy.
# Example: https://platform.bodour.ma/storage
STORAGE_BASE_URL=

# BOOTSTRAP ONLY (§15.1, Revision 22). Read by `npm run seed:production`, never
# by the running API, and only while NO active Super Administrator exists. Once
# one does, this value is ignored permanently and administrators are managed
# exclusively through the application — the database is the source of truth.
# Editing this line later does NOT move the Super Admin role.
# Identity binds on first Google login (§4.1b step 4b). Example: admin@bodour.ma
SUPER_ADMIN_EMAIL=

# The Super Administrator's sex — `female` or `male` (SRS Revision 80).
#
# Seed-only, on exactly the same terms as SUPER_ADMIN_EMAIL above: the running
# API never reads it, and the seed demands it ONLY on the branch that actually
# creates the account. Granting the role to somebody who already registered
# asks for nothing, because that person already has one.
#
# It is not defaulted, and the seed fails loudly by name rather than guessing:
# R80 forbids inferring sex from a name, a role or a title.
SUPER_ADMIN_SEX=

# production | development | test — gates exactly three behaviours: fixtures
# refuse in production (§15.2), BACKUP_TARGET_SSH is Production-only, and
# LOG_LEVEL=debug is forbidden in Production. It never changes error detail or
# any security control (Revision 104). Real beneficiary data exists only in
# Production (BR-18, R-10).
NODE_ENV=development

# ------------------------- Required in production only ------------------------

# Offsite Moroccan backup target for restic over SFTP/SSH (§6).
# Example: restic@backup.ma:/srv/bodour
BACKUP_TARGET_SSH=

# ------------------------- Optional (defaults shown) ---------------------------

# Container wall-clock alignment (TD-11).
TZ=Africa/Casablanca

# API listen port behind Nginx (§3.1).
PORT=3000

# Structured log verbosity (TD-14): info | debug. debug is prohibited in
# production (TD-13).
LOG_LEVEL=info

# --------------------- Optional: online classes (Revision 98) ------------------

# The media provider that carries a class delivered عن بُعد (R97/R98).
#
# ALL THREE OR NONE. Leaving all three empty is a complete, valid configuration:
# the platform simply offers no «دخول الحصة», and the join endpoint answers
# 503 SERVICE_UNAVAILABLE naming these settings. Setting SOME of them is refused
# at boot — a URL with no secret boots, looks configured, and then fails in front
# of a class.
#
# The secret NEVER reaches the browser: participant tokens are minted in the API
# from the platform's own authorization (R98.5) and carry only what they name.
#
# Local development (docs/development/online-class-provider.md):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d livekit
#   LIVEKIT_URL=ws://livekit:7880  LIVEKIT_API_KEY=devkey  LIVEKIT_API_SECRET=devsecret…
# Production example: wss://bodour.livekit.cloud
LIVEKIT_URL=
# The address the SERVER calls the provider on. Optional: it defaults to
# LIVEKIT_URL, which is correct wherever the browser and the API reach the
# provider at the same host — production. **Local development must set it**,
# because there LIVEKIT_URL is the host-published port and inside the API
# container that address is the container's own loopback. Local value:
#   LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# R99 — where the online-class recording facility leaves its output.
#
# A bucket the platform OWNS but does NOT serve: neither `public` nor `private`.
# The provider writes here, the platform then verifies the object and only then
# does it enter the content lifecycle — which is what keeps a temporary provider
# artefact from ever being what the library points at.
RECORDING_STAGING_BUCKET=recordings-staging
