# Infrastructure (TD-13)
DATABASE_URL="postgresql://app:development_password@localhost:5432/bodour?schema=public"
GOOGLE_CLIENT_ID="your-google-client-id-here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
JWT_SIGNING_KEY="generate-a-secure-48-character-base64-key-here"
ONBOARDING_TOKEN_KEY="generate-a-second-distinct-secure-base64-key-here"

# Storage Configuration
