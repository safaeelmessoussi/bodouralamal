# Production TLS server (SRS §3.1, R-8) — ACTIVATION TEMPLATE.
#
# Not loaded as-is: Nginx only includes conf.d/*.conf, so this file stays
# inert until the §19.1 deployment activates it. On a release host port 80
# already serves ACME and redirects all other requests. After certbot has issued
# the certificate, activation is one fail-closed command:
#
#   1. certbot certonly --webroot -w /var/www/certbot -d <domain>
#   2. BODOUR_RELEASE_TAG=<deployed-commit> \
#        bash scripts/deploy/enable-tls.sh <domain> <staging|production>
#
# One Let's Encrypt envelope wraps client, API, and storage because all three
# share this single origin (§3.1) — there is no second certificate to manage.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    # OCSP stapling is deliberately OFF. Let's Encrypt stopped publishing an
    # OCSP responder URL in its certificates, so `ssl_stapling on` staples
    # nothing and emits `"ssl_stapling" ignored, no OCSP responder URL` on every
    # start and reload. Dead config that warns forever trains an operator to
    # ignore nginx warnings, which is the actual cost.
    ssl_stapling              off;

    # HSTS is NOT set here. `add_header` does not inherit into a location that
    # declares its own, and every routed location does — so a header on this
    # block reached nothing. It is emitted per-location from the $hsts map in
    # nginx.conf, which is empty over plain HTTP and therefore still absent in
    # local development, exactly as this template originally intended.

    # Identical routing to the HTTP server — one shared snippet, so the two
    # can never drift (§19.0: no environment-conditional security divergence).
    include /etc/nginx/snippets/app-routing.conf;
}
